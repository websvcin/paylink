<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>PayLink</RootNamespace>
    <AssemblyName>PayLink</AssemblyName>
    <Version>0.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- Built from packages/ today (scripts/pack-packages.sh); from nuget.org once published. -->
    <PackageReference Include="WebSvc.PayLink.Abstractions" Version="0.1.0" />
    <PackageReference Include="WebSvc.PayLink.Storage" Version="0.1.0" />
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.1.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SQL scripts in the repository's db/ folder ship next to the app and are applied at runtime. -->
    <Content Include="..\..\db\**\*.sql" LinkBase="db" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PayLink.Tests" />
  </ItemGroup>

</Project>
