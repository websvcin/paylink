@page "/{slug}/login"
@model PayLink.Pages.Console.LoginModel
@{
    ViewData["Title"] = $"Sign in to {Model.Tenant?.Name}";
}
<div class="narrow main">
    <div class="card">
        <h1>@Model.Tenant!.Name</h1>
        <p class="muted">Sign in with your <b>@Model.Tenant.LoginlinkOrg</b> LoginLink account to open the PayLink console.</p>
        @if (Model.Error is not null) { <div class="notice bad">@Model.Error</div> }
        <div class="actions"><a class="btn pri" href="/@Model.Tenant.Slug/login?go=true">Sign in with LoginLink</a></div>
    </div>
</div>
