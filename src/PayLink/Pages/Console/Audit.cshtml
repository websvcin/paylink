@page "/{slug}/console/audit"
@model PayLink.Pages.Console.AuditModel
@{
    ViewData["Title"] = "Audit log";
    ViewData["Where"] = Model.Tenant.Name;
}
@section Nav { <partial name="_ConsoleNav" /> }
@section Who { <partial name="_ConsoleWho" /> }

<div class="head"><div><h1>Audit log</h1><p>Every action in this console, including sign-ins and support access by the platform. Entries are hash-chained.</p></div>
    <a class="btn" href="?verify=true">Verify chain</a></div>
@if (Model.ChainStatus is not null) { <div class="notice @(Model.ChainStatus.Contains("intact") ? "good" : "bad")">@Model.ChainStatus</div> }
<partial name="_AuditTable" model="Model.Entries" />
