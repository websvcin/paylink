@page "/admin/audit"
@model PayLink.Pages.Admin.AuditModel
@{
    ViewData["Title"] = "Audit log";
    ViewData["Where"] = "Platform console";
}
@section Nav { <partial name="_AdminNav" /> }
@section Who { <partial name="_AdminWho" /> }

<div class="head"><div><h1>Audit log</h1><p>Every platform action. Each entry's hash covers the one before it, so a changed or deleted entry breaks the chain.</p></div>
    <a class="btn" href="/admin/audit?handler=Verify">Verify chain</a></div>
<partial name="_AuditTable" model="Model.Entries" />
<div class="actions">
    @if (Model.Skip > 0) { <a class="btn sm" href="/admin/audit?skip=@Math.Max(0, Model.Skip - PayLink.Pages.Admin.AuditModel.PageSize)">Newer</a> }
    @if (Model.Entries.Count == PayLink.Pages.Admin.AuditModel.PageSize) { <a class="btn sm" href="/admin/audit?skip=@(Model.Skip + PayLink.Pages.Admin.AuditModel.PageSize)">Older</a> }
</div>
