@page "/admin/loginlink"
@model PayLink.Pages.Admin.LoginLinkModel
@{
    ViewData["Title"] = "LoginLink";
    ViewData["Where"] = "Platform console";
}
@section Nav { <partial name="_AdminNav" /> }
@section Who { <partial name="_AdminWho" /> }

<div class="head"><div><h1>LoginLink</h1><p>Every sign-in to PayLink goes through LoginLink.</p></div>
    <form method="post" asp-page-handler="Check"><button class="btn" type="submit">Check connection</button></form></div>

<div class="card">
    <dl class="kv">
        <dt>Server</dt><dd>@Model.Saved?.ServerUrl</dd>
        <dt>Platform organization</dt><dd><code>@(string.IsNullOrEmpty(Model.Saved?.PlatformOrg) ? "platform root" : Model.Saved.PlatformOrg)</code> · its people sign in to /admin</dd>
        <dt>PayLink admin app</dt><dd><code>@Model.Saved?.AdminClientId</code>@(string.IsNullOrEmpty(Model.Saved?.AdminAppId) ? " (entered by hand)" : $" · app {Model.Saved.AdminAppId}")</dd>
        <dt>Sign-in returns to</dt><dd><code>@Model.PublicBaseUrl/auth/callback</code></dd>
        <dt>Create organizations</dt><dd>@(Model.Saved?.CanCreateOrganizations == true ? $"Yes, with Platform API credential {Model.Saved.PlatformApiClientId}" : "No: tenants connect an existing organization")</dd>
    </dl>
</div>

<form method="post" asp-page-handler="PlatformApi" class="card">
    <h3>Platform API credential (optional)</h3>
    <p class="muted">Lets tenants create a brand-new LoginLink organization at signup. Create it in LoginLink at Admin → Platform Settings → Platform API Access, with <b>CreateTenants</b>.</p>
    <div class="grid2">
        <div class="field"><label for="clientId">Client ID</label><input id="clientId" name="clientId" class="mono" value="@Model.Saved?.PlatformApiClientId" autocomplete="off"></div>
        <div class="field"><label for="clientSecret">Client secret</label><input id="clientSecret" name="clientSecret" type="password" class="mono" autocomplete="new-password"></div>
    </div>
    @if (Model.CanChange)
    {
        <div class="actions">
            <button class="btn pri" type="submit" name="action" value="save">Test and save</button>
            @if (Model.Saved?.CanCreateOrganizations == true) { <button class="btn danger" type="submit" name="action" value="remove">Remove</button> }
        </div>
    }
</form>
