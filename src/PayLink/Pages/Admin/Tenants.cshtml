@page "/admin/tenants"
@model PayLink.Pages.Admin.TenantsModel
@{
    ViewData["Title"] = "Tenants";
    ViewData["Where"] = "Platform console";
}
@section Nav { <partial name="_AdminNav" /> }
@section Who { <partial name="_AdminWho" /> }

<div class="head"><div><h1>Tenants</h1><p>Each tenant has its own LoginLink organization and its own database.</p></div>
    <a class="btn pri" href="/admin/tenants/new">New tenant</a></div>

<form method="get" class="actions"><input type="text" name="q" value="@Model.Q" placeholder="Search by name, address or LoginLink organization" style="max-width:420px"><button class="btn" type="submit">Search</button></form>

<div class="card flush">
    <div class="tbl">
        <table>
            <thead><tr><th>Tenant</th><th>Database</th><th>LoginLink organization</th><th>Created</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @if (Model.Tenants.Count == 0)
            {
                <tr><td colspan="6" class="empty">No tenants yet. They appear here when someone signs up at /signup, or when you create one.</td></tr>
            }
            @foreach (var t in Model.Tenants)
            {
                <tr>
                    <td><b>@t.Name</b><div class="hint mono"><a href="/@t.Slug/console">/@t.Slug/console</a></div></td>
                    <td><span class="chip">@(t.DbMode switch { "sqlite" => "SQLite", "auto" => "MySQL · auto", _ => "MySQL · their own" })</span><div class="hint mono">@t.DbDisplay</div></td>
                    <td class="mono">@t.LoginlinkOrg<div class="hint">@(t.LoginlinkMode == "created" ? "created by PayLink" : "connected")@(t.ApiRegistration == "failed" ? " · API registration failed" : "")</div></td>
                    <td class="hint">@Clock.Display(t.CreatedAt)<div>via @t.CreatedVia</div></td>
                    <td>@if (t.IsActive) { <span class="chip acc">Active</span> } else { <span class="chip bad">Suspended</span> }</td>
                    <td>
                        @if (Model.CanChange)
                        {
                            <form method="post" asp-page-handler="Status" class="inline">
                                <input type="hidden" name="id" value="@t.Id">
                                @if (t.IsActive)
                                {
                                    <input type="hidden" name="status" value="suspended"><button class="btn sm danger" type="submit">Suspend</button>
                                }
                                else
                                {
                                    <input type="hidden" name="status" value="active"><button class="btn sm" type="submit">Reactivate</button>
                                }
                            </form>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
