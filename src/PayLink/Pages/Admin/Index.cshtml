@page "/admin"
@model PayLink.Pages.Admin.IndexModel
@using WebSvc.PayLink.Storage.Provisioning
@{
    ViewData["Title"] = "Platform";
    ViewData["Where"] = "Platform console";
}
@section Nav { <partial name="_AdminNav" /> }
@section Who { <partial name="_AdminWho" /> }

<div class="head"><div><h1>Platform</h1><p>Tenants, sign-in and settings for this PayLink instance.</p></div>
    <a class="btn pri" href="/admin/tenants/new">New tenant</a></div>

@if (Model.Degraded.Count > 0)
{
    <div class="notice bad">These tenants couldn't be migrated at startup and may not work: @string.Join(", ", Model.Degraded). Check the server log.</div>
}

<div class="stats">
    <div class="stat"><span>Active tenants</span><b>@Model.Counts.Active</b><small class="hint">@Model.Counts.Suspended suspended</small></div>
    <div class="stat"><span>Platform admins</span><b>@Model.Counts.Admins</b><small class="hint">@Model.Counts.PendingAdmins waiting for approval</small></div>
    <div class="stat"><span>Auto-provision approvals</span><b>@Model.Counts.Approvals</b><small class="hint">LoginLink organizations</small></div>
    <div class="stat"><span>Developer keys</span><b>@Model.Counts.Keys</b><small class="hint">active</small></div>
</div>

<div class="grid2">
    <div class="card">
        <h3>How this platform is set up</h3>
        <dl class="kv">
            <dt>Platform database</dt><dd>@Model.PlatformTarget?.Describe()</dd>
            <dt>LoginLink</dt><dd>@Model.LoginLink?.ServerUrl · organization <code>@(string.IsNullOrEmpty(Model.LoginLink?.PlatformOrg) ? "platform root" : Model.LoginLink.PlatformOrg)</code></dd>
            <dt>New organizations</dt><dd>@(Model.LoginLink?.CanCreateOrganizations == true ? "Tenants can create one at signup" : "Tenants connect an existing organization")</dd>
            <dt>Database hosting</dt><dd>@Model.Hosting.Describe()</dd>
            <dt>Tenant signup</dt><dd>@(Model.SignupOpen ? "Open at /signup" : "Closed; platform admins create tenants")</dd>
        </dl>
    </div>
    <div class="card">
        <div class="head"><h3>Recent activity</h3><a href="/admin/audit" class="hint">Audit log</a></div>
        @if (Model.Recent.Count == 0) { <p class="hint">Nothing yet.</p> }
        <div class="activity">
            @foreach (var e in Model.Recent)
            {
                <div><time>@Clock.Short(e.At)</time><span><code>@e.Action</code> @e.Target <span class="hint">· @e.ActorName</span></span></div>
            }
        </div>
    </div>
</div>
