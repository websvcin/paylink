@if (TempData["Ok"] is string ok)
{
    <div class="notice good" role="status">@ok</div>
}
@if (TempData["Error"] is string error)
{
    <div class="notice bad" role="alert">@error</div>
}
@if (TempData["Secret"] is string secret)
{
    <div class="notice warn" role="status">
        <p><b>Copy this now.</b> It's shown only once and PayLink keeps only a hash of it.</p>
        <p class="secret" style="margin-top:8px">@secret</p>
    </div>
}
