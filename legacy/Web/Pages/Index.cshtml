@page
@model Web.Pages.IndexModel
@{
    ViewData["Title"] = "Make a Payment";
}

@section Styles {
    <!-- External CSS -->
    <link rel="stylesheet" href="~/css/payment.css" />

    <!-- Bootstrap-select for better currency dropdown -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/css/bootstrap-select.min.css">
}

<!-- 🌟 Progress Steps -->
<div class="step-progress">
    <div class="step active" id="step1">
        <div class="step-circle">1</div>
        <div class="step-label">Details</div>
    </div>
    <div class="step" id="step2">
        <div class="step-circle">2</div>
        <div class="step-label">Gateway</div>
    </div>
    <div class="step" id="step3">
        <div class="step-circle">3</div>
        <div class="step-label">Redirecting</div>
    </div>
</div>

<!-- 💳 Payment Form -->
<div class="payment-container step-fade show" id="formStep">
    <div class="payment-header">
        <h3><i class="bi bi-credit-card-2-front me-2"></i>Complete Your Payment</h3>
    </div>

    <form method="post" id="paymentForm" class="payment-form needs-validation" novalidate>
        <div class="row g-4">
            <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input type="text" name="name" class="form-control" required placeholder="John Doe" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Email</label>
                <input type="email" name="email" class="form-control" required placeholder="john@example.com" />
            </div>

            <div class="col-md-6">
                <label class="form-label">Mobile</label>
                <input type="text" name="mobile" class="form-control" required placeholder="+91 98765 43210" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Amount</label>
                <input type="number" name="amount" class="form-control" required placeholder="1000" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Currency</label>
                <select name="currency" class="form-select selectpicker" data-live-search="true" required>
                    <option value="INR" data-content="<span class='fi fi-in me-2'></span>INR (₹)" selected>
                        INR (₹)
                    </option>
                    <option value="USD" data-content="<span class='fi fi-us me-2'></span>USD ($)">
                        USD ($)
                    </option>
                    <option value="EUR" data-content="<span class='fi fi-eu me-2'></span>EUR (€)">
                        EUR (€)
                    </option>
                </select>
            </div>

        </div>

        <input type="hidden" id="paymentMethod" name="paymentMethod" />

        <div class="mt-5 text-center">
            <button type="button" id="proceedButton" class="btn btn-primary">
                <i class="bi bi-arrow-right-circle me-2"></i>Proceed to Payment
            </button>
        </div>
    </form>
</div>

<!-- 🏦 Gateway Modal -->
<div class="modal fade" id="gatewayModal" tabindex="-1" aria-labelledby="gatewayModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content border-0 shadow-lg">
      <div class="modal-header border-0">
        <h5 class="modal-title fw-semibold" id="gatewayModalLabel">Select Payment Method</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <p class="text-muted mb-4">Choose your preferred payment gateway</p>
        <div class="d-grid gap-3">
          <button type="button" class="btn btn-outline-success gateway-btn" data-method="phonepe">
              <i class="bi bi-phone me-2"></i> PhonePe
          </button>
          @* <button type="button" class="btn btn-outline-primary gateway-btn" data-method="payu">
              <i class="bi bi-wallet2 me-2"></i> PayU
          </button> *@
          <button type="button" class="btn btn-outline-dark gateway-btn" data-method="upiqr">
              <i class="bi bi-upc me-2"></i> UPI QR <small>Manual</small><span class="badge bg-danger ms-2">NEW</span>
          </button>
          @* <button type="button" class="btn btn-outline-info gateway-btn" data-method="ccavenue">
              <i class="bi bi-credit-card me-2"></i> CCAvenue
          </button> *@
          <button type="button" class="btn btn-outline-secondary gateway-btn" data-method="razorpay">
              <i class="bi bi-bank me-2"></i> RazorPay
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
    <!-- Bootstrap-select script -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap-select@1.14.0-beta3/dist/js/bootstrap-select.min.js"></script>
    <!-- External JS -->
    <script src="~/js/payment.js"></script>
}
