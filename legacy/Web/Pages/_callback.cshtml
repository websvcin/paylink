@page "/_callback/{gateway?}"
@model Web.Pages.PaymentCallbackModel
@{
    ViewData["Title"] = "Payment Callback | PAY.WEBSVC.IN";
    Layout = "~/Pages/Shared/_Layout2.cshtml";
}

<link rel="stylesheet" href="~/css/payment-callback.css" />

<div class="callback-wrapper">
    <div class="card callback-card">
        <div class="card-body text-center">
            <div id="loaderContainer" class="loader-container">
                <div class="spinner-border spinner-lg text-success" role="status" aria-hidden="true"></div>
                <p class="verifying-text mt-3">Almost done! We're verifying your payment with <strong>@(Model.GatewayDisplayName)</strong>...</p>
                <p class="countdown-text" id="countdownText">Time left: 01:00</p>
                <div class="progress mt-3" style="height:10px;">
                    <div id="progressBar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar"
                         style="width:0%" aria-valuenow="0" aria-valuemin="0" aria-valuemax="60"></div>
                </div>
            </div>

            <div id="statusContainer" class="status-container d-none mt-4">
                <div id="statusIcon" class="status-icon mb-3" aria-hidden="true"></div>
                <h2 id="statusText" class="status-text"></h2>
                <p id="statusDetails" class="small text-muted mt-3"></p>
            </div>

            <div id="pendingContainer" class="pending-container d-none mt-4">
                <div class="pending-icon mb-2">⌛</div>
                <p class="pending-text">Payment is still processing. We recommend waiting a little longer or using "Check Status Now".</p>
                <div class="mt-3">
                    <a asp-page="/Index" class="btn btn-outline-primary me-2">Return Home</a>
                    <button id="pendingRetry" class="btn btn-secondary">Retry Verification</button>
                </div>
            </div>

            <div id="errorContainer" class="d-none mt-4">
                <h4 class="text-danger">We couldn't confirm your payment</h4>
                <p class="text-muted">Please try again or contact support with PaymentId: <strong>@Model.PaymentId</strong></p>
                <a asp-page="/Index" class="btn btn-primary">Go to Home</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Expose server-provided values to JS
        const PAYMENT_ID = "@Model.PaymentId";
        const GATEWAY = "@(Model.gateway ?? "")";
        const WS_URL = "@(Model.WebSocketUrl ?? "")"; // may be empty
        const REDIRECT_URL = "@Model.RedirectUrl";
        // 👇 expose backend flag
        const ENABLE_MANUAL_REDIRECT = @Model.EnableManualRedirect.ToString().ToLower();
        const PAYMENT_AMOUNT = @Model.Amount;
        @* const CHECK_STATUS_URL = "@Url.Page("._callback", new { handler = "checkstatus" })"; // we'll call with ?handler=checkstatus *@
        // Build the full status-check API URL here
        const CHECK_STATUS_URL = "@($"{Model.ApiBaseUrl}/payment/payment-status/{Model.PaymentId}")";
    </script>

    <script src="~/js/payment-callback.js"></script>
}
