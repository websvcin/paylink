@page
@model Web.Pages.DefaultModel
@{
    ViewData["Title"] = "Select Payment Gateway | PAY.WEBSVC.IN";
    Layout = "~/Pages/Shared/_Layout2.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
    <style>
        body {
            background: #f7f9fc;
        }

        .payment-selection-container {
            max-width: 650px;
            margin: 60px auto;
            background: #fff;
            border-radius: 12px;
            box-shadow: 0 0 25px rgba(0, 0, 0, 0.08);
            overflow: hidden;
        }

        .header-bar {
            background: linear-gradient(135deg, #007bff, #6610f2);
            color: white;
            padding: 20px;
            text-align: center;
        }

        .header-bar h4 {
            margin: 0;
            font-weight: 600;
        }

        .gateway-list {
            padding: 30px;
        }

        .gateway-btn {
            padding: 16px;
            border: 2px solid #e5e7eb;
            border-radius: 10px;
            transition: all 0.3s;
            font-size: 1.1rem;
            font-weight: 500;
        }

        .gateway-btn:hover {
            background: #007bff;
            color: #fff;
            border-color: #007bff;
        }

        /* ✅ Loader overlay (hidden by default) */
        .loading-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(255, 255, 255, 0.85);
            z-index: 2000;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease-in-out;
        }

        .loading-overlay.active {
            display: flex;
            opacity: 1;
        }

        .spinner-border {
            width: 3rem;
            height: 3rem;
        }

        .footer-note {
            text-align: center;
            padding: 15px;
            color: #888;
            font-size: 0.9rem;
        }
    </style>
}

<div class="payment-selection-container">
    <div class="header-bar">
        <h4><i class="bi bi-bank2 me-2"></i>Choose Your Payment Gateway</h4>
        <p class="mb-0">Payment ID: <strong>@Model.PaymentId</strong></p>
    </div>

    <div class="gateway-list text-center">
        <p class="text-muted mb-4">Please select a payment method to continue</p>

        <form method="post" id="gatewayForm">
            <input type="hidden" name="PaymentId" value="@Model.PaymentId" />
            <input type="hidden" id="SelectedGateway" name="SelectedGateway" />

            <div class="d-grid gap-3">
                <button type="button" class="btn btn-light gateway-btn" data-gateway="PhonePe">
                    <i class="bi bi-phone me-2 text-success"></i> PhonePe
                </button>
                <button type="button" class="btn btn-light gateway-btn" data-gateway="RazorPay">
                    <i class="bi bi-bank me-2 text-primary"></i> RazorPay
                </button>
                <button type="button" class="btn btn-light gateway-btn" data-gateway="UPIQR">
                    <i class="bi bi-upc-scan me-2 text-dark"></i> UPI QR 
                    <span class="badge bg-danger ms-2">Manual</span>
                </button>
            </div>
        </form>
    </div>

    <div class="footer-note">
        <small>Secure payments powered by <strong>PAY.WEBSVC.IN</strong></small>
    </div>
</div>

<!-- 🔄 Loading overlay -->
<div class="loading-overlay" id="loadingOverlay">
    <div class="text-center">
        <div class="spinner-border text-primary mb-3" role="status"></div>
        <div><strong>Updating payment method...</strong></div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Handle gateway selection
        document.querySelectorAll('.gateway-btn').forEach(btn => {
            btn.addEventListener('click', function () {
                const gateway = this.dataset.gateway;
                document.getElementById('SelectedGateway').value = gateway;
                document.getElementById('loadingOverlay').classList.add('active');
                document.getElementById('gatewayForm').submit();
            });
        });
    </script>
}