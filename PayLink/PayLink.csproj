<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>PayLink</RootNamespace>
    <AssemblyName>PayLink</AssemblyName>
    <Version>0.2.0</Version>
    <!-- The test project lives inside this folder; keep its files (and its bin/obj) out of the app. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);PayLink.Tests/**;App_Data/**</DefaultItemExcludes>
  </PropertyGroup>

  <!-- WebSvc.PayLink.* packages: built from ../packages into ../artifacts/packages today, from nuget.org once published.
       Each has its own version; bump the one you changed. -->
  <ItemGroup>
    <PayLinkLocalPackage Include="WebSvc.PayLink.Abstractions" Version="0.1.0" />
    <PayLinkLocalPackage Include="WebSvc.PayLink.Storage" Version="0.3.0" />
    <PayLinkLocalPackage Include="WebSvc.PayLink.Connector.Simulator" Version="0.1.0" />
    <PayLinkLocalPackage Include="WebSvc.PayLink.Connector.Upi" Version="0.1.0" />
    <PackageReference Include="@(PayLinkLocalPackage)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.IdentityModel.Protocols.OpenIdConnect" Version="8.1.2" />
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <PropertyGroup>
    <PayLinkPackagesSource>$(MSBuildThisFileDirectory)..\packages</PayLinkPackagesSource>
    <PayLinkLocalFeed>$(MSBuildThisFileDirectory)..\artifacts\packages</PayLinkLocalFeed>
  </PropertyGroup>

  <!--
    On a fresh checkout the local feed is empty, so restore would fail with NU1301.
    Before restoring, pack each WebSvc.PayLink.* package from ../packages into the feed if that version is missing.
    Works the same on Windows, macOS and Linux; scripts/pack-packages.sh does the same and also refreshes the NuGet cache.
  -->
  <Target Name="PackLocalPayLinkPackages"
          BeforeTargets="Restore;_GenerateRestoreGraph;_GenerateRestoreGraphProjectEntry;_GenerateProjectRestoreGraph"
          Condition="Exists('$(PayLinkPackagesSource)')">
    <ItemGroup>
      <_PayLinkMissing Include="@(PayLinkLocalPackage)" Condition="!Exists('$(PayLinkLocalFeed)\%(Identity).%(Version).nupkg')" />
    </ItemGroup>
    <Message Importance="high" Text="PayLink: packing %(_PayLinkMissing.Identity) %(_PayLinkMissing.Version) from ../packages into ../artifacts/packages" Condition="'@(_PayLinkMissing)' != ''" />
    <MakeDir Directories="$(PayLinkLocalFeed)" Condition="'@(_PayLinkMissing)' != ''" />
    <Exec Command="dotnet pack &quot;$(PayLinkPackagesSource)\%(_PayLinkMissing.Identity)\%(_PayLinkMissing.Identity).csproj&quot; -c Release -o &quot;$(PayLinkLocalFeed)&quot; --nologo -v quiet" Condition="'@(_PayLinkMissing)' != ''" />
  </Target>

  <ItemGroup>
    <!-- The SQL scripts in db/ ship next to the app and are applied at runtime. -->
    <Content Include="db\**\*.sql" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="PayLink.Tests" />
  </ItemGroup>

</Project>
