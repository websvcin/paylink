<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- WebSvc.PayLink.* packages built from ../packages by ../scripts/pack-packages.sh.
         Once they are published to nuget.org this source can be removed. -->
    <add key="paylink-local" value="../artifacts/packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="paylink-local">
      <package pattern="WebSvc.PayLink.*" />
    </packageSource>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
