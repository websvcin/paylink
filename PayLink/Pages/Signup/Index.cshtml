@page "/signup"
@model PayLink.Pages.Signup.IndexModel
@{
    ViewData["Title"] = "Create a PayLink account";
    ViewData["Where"] = "New account";
}
<div class="narrow main">
    <div class="head"><div><h1>Create a PayLink account</h1><p>Your team signs in through LoginLink. Connect the organization you already use, then choose where your payment data lives.</p></div></div>

    @if (Model.Message is not null) { <div class="notice good" role="status">@Model.Message</div> }
    @if (Model.Error is not null) { <div class="notice bad" role="alert">@Model.Error</div> }
    @if (Model.SignInBlocked is not null)
    {
        <form method="post" asp-page-handler="ContinueSignIn" class="card">
            <h3>One thing to do in LoginLink first</h3>
            <p class="muted">PayLink registered its console app in your organization, but couldn't switch on a way to sign in to it.</p>
            <div class="notice warn">@Model.SignInBlocked</div>
            <div class="actions"><button class="btn pri" type="submit">I've turned it on: continue to sign in</button></div>
        </form>
    }

    @if (!Model.SignupOpen)
    {
        <div class="card"><h2>Signup is closed</h2><p>New PayLink accounts are created by the platform administrator on this server. Ask them to create one for you.</p></div>
        return;
    }

    <nav class="steps" aria-label="Signup steps">
        <span class="step @(Model.Step == "org" ? "now" : "done")">LoginLink organization</span>
        <span class="step @(Model.Step == "verify" ? "now" : Model.Step == "details" ? "done" : "")">Sign in</span>
        <span class="step @(Model.Step == "details" ? "now" : "")">Name and data</span>
    </nav>

    @if (Model.Step == "org")
    {
        <form method="post" asp-page-handler="ConnectExisting" class="card">
            <h2>Connect my existing LoginLink organization</h2>
            <p class="muted">Your team keeps signing in the way they already do. PayLink registers a "PayLink console" app in your organization, then asks you to sign in to prove you're an admin there.</p>
            <div class="field"><label for="OrgSlug">Organization slug</label>
                <div class="prefix"><span>@(Model.LoginLinkServer.Replace("https://", "").Replace("http://", ""))/</span><input id="OrgSlug" name="OrgSlug" class="mono" value="@Model.OrgSlug" placeholder="acme" autocomplete="off"></div>
            </div>
            <div class="grid2">
                <div class="field"><label for="MgmtClientId">Management credential: client ID</label><input id="MgmtClientId" name="MgmtClientId" class="mono" autocomplete="off"></div>
                <div class="field"><label for="MgmtClientSecret">Client secret</label><input id="MgmtClientSecret" name="MgmtClientSecret" type="password" class="mono" autocomplete="new-password"></div>
            </div>
            <p class="hint">Create it in LoginLink: Console → API Access → New credential, with <b>Register apps</b> and <b>Manage APIs</b>. It's stored encrypted.</p>
            <div class="actions"><button class="btn pri" type="submit">Connect and sign in</button></div>
        </form>

        @if (Model.CanCreateOrganizations)
        {
            <form method="post" asp-page-handler="CreateNew" class="card">
                <h2>Or create a new LoginLink organization</h2>
                <p class="muted">PayLink creates it for you and you become its first admin. Your password goes to LoginLink only.</p>
                <div class="grid2">
                    <div class="field"><label for="NewOrgName">Business name</label><input id="NewOrgName" name="NewOrgName" value="@Model.NewOrgName"></div>
                    <div class="field"><label for="AdminName">Your name</label><input id="AdminName" name="AdminName" value="@Model.AdminName" autocomplete="name"></div>
                    <div class="field"><label for="AdminEmail">Your email</label><input id="AdminEmail" name="AdminEmail" type="email" value="@Model.AdminEmail" autocomplete="email"></div>
                    <div class="field"><label for="AdminPassword">Password for LoginLink</label><input id="AdminPassword" name="AdminPassword" type="password" autocomplete="new-password"></div>
                </div>
                <p class="hint">If LoginLink then says your account "has no sign-in method available for this app", open your new organization in LoginLink (Console → Apps → PayLink console → Connectors), turn on Email &amp; Password, and sign in again.</p>
                <div class="actions"><button class="btn" type="submit">Create organization and sign in</button></div>
            </form>
        }
    }
    else if (Model.Step == "verify")
    {
        <div class="card">
            <h2>Sign in to @Model.Session!.Org!.OrgSlug</h2>
            <p class="muted">PayLink is connected to the LoginLink organization <b>@Model.Session.Org.OrgSlug</b>. Sign in as one of its admins to continue.</p>
            <div class="actions">
                <form method="post" asp-page-handler="SignInAgain" class="inline"><button class="btn pri" type="submit">Sign in with LoginLink</button></form>
                <form method="post" asp-page-handler="Restart" class="inline"><button class="btn" type="submit">Start over</button></form>
            </div>
        </div>
    }
    else
    {
        <form method="post" asp-page-handler="Create" class="card">
            <div class="notice good">Signed in as <b>@(Model.Session!.Email ?? Model.Session.PersonName)</b>, admin of LoginLink organization <b>@Model.Session.Org!.OrgSlug</b>.</div>
            <h2>Name and address</h2>
            <div class="grid2">
                <div class="field"><label for="TenantName">Business name</label><input id="TenantName" name="TenantName" value="@Model.TenantName"></div>
                <div class="field"><label for="TenantSlug">Console address</label>
                    <div class="prefix"><span>/</span><input id="TenantSlug" name="TenantSlug" class="mono" value="@Model.TenantSlug"></div>
                    <span class="hint" id="slugHint">Your console will be at /<span id="slugEcho">@Model.TenantSlug</span>/console</span>
                </div>
            </div>

            <h2>Where should your payment data live?</h2>
            <p class="hint">You can move to another engine later.</p>
            <div class="opts">
                @if (Model.DbOptions.Contains(TenantDbOptions.Sqlite))
                {
                    <label class="opt"><input type="radio" name="DbChoice" value="sqlite" checked="@(Model.DbChoice == "sqlite")"><div><b>SQLite, managed by PayLink <span class="chip acc">Recommended to start</span></b><span>Nothing to set up. Good for testing and small to medium volumes.</span></div></label>
                }
                @if (Model.DbOptions.Contains(TenantDbOptions.Auto))
                {
                    if (Model.AutoProvision.Allowed)
                    {
                        <label class="opt"><input type="radio" name="DbChoice" value="auto" checked="@(Model.DbChoice == "auto")"><div><b>Create a MySQL database for me</b><span>PayLink creates a dedicated database and user on the platform's hosting. Nothing to fill in.</span></div></label>
                    }
                    else
                    {
                        <div class="opt disabled"><input type="radio" disabled><div><b>Create a MySQL database for me</b><span>@Model.AutoProvision.Reason</span></div></div>
                    }
                }
                @if (Model.DbOptions.Contains(TenantDbOptions.Byo))
                {
                    <label class="opt"><input type="radio" name="DbChoice" value="byo" checked="@(Model.DbChoice == "byo")"><div><b>Use my own MySQL or PostgreSQL</b><span>You run and back up the database. It must be empty. The password is stored encrypted.</span></div></label>
                    <div class="reveal card"><partial name="_ServerDbFields" model='("Byo", Model.Byo)' /></div>
                }
            </div>
            <div class="actions">
                <button class="btn" type="submit" name="action" value="test">Test my MySQL</button>
                <button class="btn pri" type="submit" name="action" value="create">Create my PayLink account</button>
            </div>
        </form>
        <form method="post" asp-page-handler="Restart"><button class="btn sm" type="submit">Start over</button></form>
        <script>
            (() => {
                const input = document.getElementById('TenantSlug'), echo = document.getElementById('slugEcho'), hint = document.getElementById('slugHint');
                let t;
                input.addEventListener('input', () => {
                    echo.textContent = input.value;
                    clearTimeout(t);
                    t = setTimeout(async () => {
                        try {
                            const r = await fetch('?handler=Slug&slug=' + encodeURIComponent(input.value));
                            const j = await r.json();
                            hint.textContent = j.message;
                            hint.style.color = j.ok ? 'var(--good)' : 'var(--bad)';
                        } catch { /* the server check on submit still applies */ }
                    }, 300);
                });
            })();
        </script>
    }
</div>
