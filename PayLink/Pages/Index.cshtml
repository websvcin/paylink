@page "/"
@model PayLink.Pages.IndexModel
@{
    ViewData["Title"] = "PayLink";
}
<div class="narrow main">
    <div class="head"><div><h1>PayLink</h1><p>One integration for your app. Every payment method becomes a setting.</p></div></div>
    <div class="grid2">
        <form method="post" class="card">
            <h3>Sign in to your console</h3>
            <div class="field"><label for="slug">Your PayLink address</label><div class="prefix"><span>/</span><input id="slug" name="slug" class="mono" placeholder="acme"></div></div>
            @if (Model.Error is not null) { <p class="notice bad">@Model.Error</p> }
            <div class="actions"><button class="btn pri" type="submit">Continue</button></div>
        </form>
        <div class="card">
            <h3>New to PayLink?</h3>
            @if (Model.SignupOpen)
            {
                <p class="muted">Connect your LoginLink organization and choose where your payment data lives.</p>
                <div class="actions"><a class="btn" href="/signup">Create an account</a></div>
            }
            else
            {
                <p class="muted">Accounts on this server are created by its administrator.</p>
            }
            <p class="hint">Running this server? <a href="/admin">Platform console</a></p>
        </div>
    </div>
</div>
