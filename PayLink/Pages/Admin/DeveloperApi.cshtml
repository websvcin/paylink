@page "/admin/developer-api"
@model PayLink.Pages.Admin.DeveloperApiModel
@{
    ViewData["Title"] = "Developer API";
    ViewData["Where"] = "Platform console";
    var baseUrl = $"{Request.Scheme}://{Request.Host}";
}
@section Nav { <partial name="_AdminNav" /> }
@section Who { <partial name="_AdminWho" /> }

<div class="head"><div><h1>Developer API</h1><p>Platform developer keys (<code>pdk_</code>) automate this console from scripts. Each key gets only the capabilities you tick. A key can never create another platform key.</p></div></div>

<div class="card">
    <h3>Building a product on PayLink</h3>
    <p class="muted">Give your product one platform key with <b>Tenants</b> and <b>Act for tenants</b>. It can then create a tenant for each of your customers and do, for each of them, everything their admin can do in the console, with no per-tenant key to store:</p>
    <pre class="secret" style="white-space:pre-wrap;user-select:text"># Platform API: create the tenant
curl -X POST @baseUrl/api/admin/tenants -H "Authorization: Bearer pdk_…" -H "Content-Type: application/json" -d '{ … }'

# Tenant API, acting for that tenant: turn on PayLink UPI
curl -X PUT @baseUrl/api/tenant/methods/upi/test -H "Authorization: Bearer pdk_…" -H "PayLink-Tenant: acme" \
  -H "Content-Type: application/json" -d '{ "enabled": true, "settings": { "vpa": "acme@okhdfcbank", "payee_name": "Acme" } }'

# Payments API, acting for that tenant (PayLink-Mode: test or live)
curl -X POST @baseUrl/api/v1/payments -H "Authorization: Bearer pdk_…" -H "PayLink-Tenant: acme" -H "PayLink-Mode: test" \
  -H "Content-Type: application/json" -d '{ "amount": 49900, "currency": "INR" }'</pre>
    <p class="hint">Or create keys for a tenant with <code>POST /api/admin/tenants/{id}/keys</code> (an <code>sk_</code> key for its own server, or a <code>tdk_</code> key with chosen capabilities). A key with reach "only tenants it creates" can't act for any other tenant. Every call is in the tenant's audit log under the platform key's name. Reference: <a href="/docs/api/index.html?urls.primaryName=Platform%20API">Platform API</a>.</p>
</div>

<div class="card flush">
    <div class="tbl">
        <table>
            <thead><tr><th>Name</th><th>Key</th><th>Capabilities</th><th>Reach</th><th>Last used</th><th></th></tr></thead>
            <tbody>
            @if (Model.Keys.Count == 0) { <tr><td colspan="6" class="empty">No keys yet.</td></tr> }
            @foreach (var k in Model.Keys)
            {
                <tr>
                    <td><b>@k.Name</b><div class="hint">by @k.CreatedBy · @Clock.Display(k.CreatedAt)</div></td>
                    <td><code>@k.KeyPrefix…</code></td>
                    <td class="hint">@string.Join(", ", k.CapabilityList)</td>
                    <td class="hint">@(k.Reach == "own" ? "Only tenants it creates" : "All tenants")@(k.CreationLimit is { } l ? $" · limit {l}" : "")@(k.ExpiresAt is null ? "" : " · expires " + Clock.Display(k.ExpiresAt))</td>
                    <td class="hint">@Clock.Display(k.LastUsedAt)</td>
                    <td>@if (k.RevokedAt is not null) { <span class="chip">Revoked</span> } else if (!k.IsUsable) { <span class="chip">Expired</span> } else if (Model.CanChange) { <form method="post" asp-page-handler="Revoke" class="inline"><input type="hidden" name="id" value="@k.Id"><button class="btn sm danger" type="submit">Revoke</button></form> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

@if (Model.CanChange)
{
    <form method="post" asp-page-handler="Create" class="card">
        <h3>New key</h3>
        <div class="field"><label for="Name">Name</label><input id="Name" name="Name" placeholder="e.g. Signup automation"></div>
        <div class="caps">
            @foreach (var (name, label, covers) in Capabilities.All)
            {
                <label><input type="checkbox" name="Caps" value="@name"><div><b>@label</b><span>@covers</span></div></label>
            }
        </div>
        <div class="grid3">
            <div class="field"><label for="Reach">Reach (for Tenants)</label><select id="Reach" name="Reach"><option value="all">All tenants</option><option value="own">Only tenants this key creates</option></select></div>
            <div class="field"><label for="CreationLimit">Tenant creation limit</label><input id="CreationLimit" name="CreationLimit" type="number" min="1" placeholder="No limit"></div>
            <div class="field"><label for="ExpiresOn">Expires on</label><input id="ExpiresOn" name="ExpiresOn" type="date"></div>
        </div>
        <div class="actions"><button class="btn pri" type="submit">Create key</button></div>
    </form>
}

<div class="card">
    <h3>Try it</h3>
<pre class="secret" style="white-space:pre-wrap">curl -H "Authorization: Bearer pdk_…" @baseUrl/api/admin/tenants
curl -H "Authorization: Bearer pdk_…" @baseUrl/api/admin/dashboard</pre>
    <p class="hint">A key missing a capability gets <code>403 insufficient_scope</code>. See docs/platform-api.md for every endpoint.</p>
</div>
