@{
    var current = ViewContext.RouteData.Values["page"] as string ?? "";
    string Cur(string page) => current == page ? "page" : "false";
    var pending = ViewData["PendingAdmins"] as int? ?? 0;
}
<span class="grp">Platform</span>
<a href="/admin" aria-current="@Cur("/Admin/Index")">Dashboard</a>
<a href="/admin/tenants" aria-current="@(current.StartsWith("/Admin/Tenant") ? "page" : "false")">Tenants</a>
<a href="/admin/connectors" aria-current="@Cur("/Admin/Connectors")">Connector catalog</a>
<span class="grp">Access</span>
<a href="/admin/access" aria-current="@Cur("/Admin/Access")">Sign-in access @if (pending > 0) { <span class="count">@pending</span> }</a>
<a href="/admin/developer-api" aria-current="@Cur("/Admin/DeveloperApi")">Developer API</a>
<span class="grp">Settings</span>
<a href="/admin/auto-provisioning" aria-current="@Cur("/Admin/AutoProvisioning")">Auto-provisioning</a>
<a href="/admin/hosting" aria-current="@Cur("/Admin/Hosting")">Database hosting</a>
<a href="/admin/location" aria-current="@Cur("/Admin/Location")">Location data</a>
<a href="/admin/loginlink" aria-current="@Cur("/Admin/LoginLink")">LoginLink</a>
<a href="/admin/settings" aria-current="@Cur("/Admin/Settings")">Platform settings</a>
<a href="/admin/audit" aria-current="@Cur("/Admin/Audit")">Audit log</a>
