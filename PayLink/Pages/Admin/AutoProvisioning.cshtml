@page "/admin/auto-provisioning"
@model PayLink.Pages.Admin.AutoProvisioningModel
@{
    ViewData["Title"] = "Auto-provisioning";
    ViewData["Where"] = "Platform console";
}
@section Nav { <partial name="_AdminNav" /> }
@section Who { <partial name="_AdminWho" /> }

<div class="head"><div><h1>Auto-provisioning</h1><p>Who may have a MySQL database created for them at signup. Everyone else can still choose SQLite or bring their own MySQL or PostgreSQL.</p></div></div>
@if (!Model.HostingConfigured)
{
    <div class="notice warn">No database hosting is set up, so nobody can auto-provision yet. <a href="/admin/hosting">Set up database hosting</a>.</div>
}

<form method="post" asp-page-handler="Mode" class="card">
    <div class="opts">
        <label class="opt"><input type="radio" name="mode" value="off" checked="@(Model.Mode == AutoProvisionModes.Off)"><div><b>Off</b><span>Nobody can auto-provision at signup. You can still create one for a tenant from Tenants → New tenant.</span></div></label>
        <label class="opt"><input type="radio" name="mode" value="approved" checked="@(Model.Mode == AutoProvisionModes.Approved)"><div><b>Approved LoginLink organizations only</b><span>Add an organization's slug before they sign up. They prove who they are by signing in through LoginLink as its admin, so no email check is needed.</span></div></label>
        <label class="opt"><input type="radio" name="mode" value="everyone" checked="@(Model.Mode == AutoProvisionModes.Everyone)"><div><b>Everyone</b><span>Any new tenant. Each database is created on your hosting account, with its limits and costs.</span></div></label>
    </div>
    @if (Model.CanChange) { <div class="actions"><button class="btn pri" type="submit">Save</button></div> }
</form>

<div class="card">
    <h3>Approved organizations</h3>
    @if (Model.CanChange)
    {
        <form method="post" asp-page-handler="Add" class="grid3">
            <input type="text" name="orgSlug" class="mono" placeholder="LoginLink organization slug, e.g. shopnow" aria-label="Organization slug">
            <input type="text" name="note" placeholder="Note (optional)" aria-label="Note">
            <button class="btn pri" type="submit">Approve</button>
        </form>
    }
    <div class="tbl">
        <table>
            <thead><tr><th>LoginLink organization</th><th>Note</th><th>Approved</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @if (Model.Approvals.Count == 0) { <tr><td colspan="5" class="empty">No organizations approved yet.</td></tr> }
            @foreach (var a in Model.Approvals)
            {
                <tr>
                    <td class="mono">@a.OrgSlug</td>
                    <td class="hint">@a.Note</td>
                    <td class="hint">@Clock.Display(a.CreatedAt) · @a.CreatedBy</td>
                    <td>@if (a.UsedAt is null) { <span class="chip">Not signed up yet</span> } else { <span class="chip good">Database created</span> }</td>
                    <td>@if (Model.CanChange) { <form method="post" asp-page-handler="Remove" class="inline"><input type="hidden" name="orgSlug" value="@a.OrgSlug"><button class="btn sm danger" type="submit">Remove</button></form> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
