@page "/admin/settings"
@model PayLink.Pages.Admin.SettingsModel
@{
    ViewData["Title"] = "Platform settings";
    ViewData["Where"] = "Platform console";
}
@section Nav { <partial name="_AdminNav" /> }
@section Who { <partial name="_AdminWho" /> }

<div class="head"><div><h1>Platform settings</h1></div></div>
<form method="post" class="card">
    <h3>Tenant signup</h3>
    <div class="opts">
        <label class="opt"><input type="radio" name="signup" value="open" checked="@Model.SignupOpen"><div><b>Open</b><span>Anyone who is an admin of a LoginLink organization can create a PayLink account at /signup.</span></div></label>
        <label class="opt"><input type="radio" name="signup" value="off" checked="@(!Model.SignupOpen)"><div><b>Closed</b><span>Only platform admins create tenants (Tenants → New tenant, or the Developer API).</span></div></label>
    </div>
    <h3>Public address</h3>
    <div class="field"><label for="publicBaseUrl">PayLink's public address</label><input id="publicBaseUrl" name="publicBaseUrl" class="mono" value="@Model.PublicBaseUrl"><span class="hint">LoginLink sends people back to <code>@Model.PublicBaseUrl/auth/callback</code>. If you change this, update the redirect URI of every PayLink app in LoginLink too.</span></div>
    @if (Model.CanChange) { <div class="actions"><button class="btn pri" type="submit">Save</button></div> }
</form>

<form method="post" asp-page-handler="DbOptions" class="card">
    <h3>Tenant database options</h3>
    <p class="hint">Which choices new tenants see at /signup. As a platform admin you can always use any of them (Tenants → New tenant).</p>
    <div class="caps">
        @foreach (var (key, label, help) in TenantDbOptions.All)
        {
            <label><input type="checkbox" name="options" value="@key" checked="@Model.TenantDbOptionsAllowed.Contains(key)"><div><b>@label</b><span>@help</span></div></label>
        }
    </div>
    @if (Model.CanChange) { <div class="actions"><button class="btn pri" type="submit">Save</button></div> }
</form>

<div class="card">
    <h3>Database engines in this version</h3>
    <p class="hint">Which engines this build of PayLink can use, for the platform database and tenant databases. An engine becomes available when the storage package supports it; there's nothing to turn on here.</p>
    <div class="tbl">
        <table>
            <thead><tr><th>Engine</th><th>Status</th><th></th></tr></thead>
            <tbody>
            @foreach (var e in EngineCatalog.All)
            {
                <tr><td><b>@e.Name</b></td><td>@if (e.Available) { <span class="chip good">Available</span> } else { <span class="chip">Not in this version</span> }</td><td class="hint">@e.Note</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>

<form method="post" asp-page-handler="Smtp" class="card">
    <h3>Email (SMTP)</h3>
    <p class="hint">Optional. Used for tenants' alerts. The password is stored encrypted.</p>
    <div class="grid3">
        <div class="field"><label for="smtpHost">Server</label><input id="smtpHost" name="host" class="mono" value="@Model.Smtp?.Host" placeholder="smtp.example.com (blank: off)"></div>
        <div class="field"><label for="smtpPort">Port</label><input id="smtpPort" name="port" type="number" value="@(Model.Smtp?.Port ?? 587)"></div>
        <div class="field"><label for="smtpFrom">From</label><input id="smtpFrom" name="from" type="email" value="@Model.Smtp?.From" placeholder="alerts@example.com"></div>
        <div class="field"><label for="smtpUser">User</label><input id="smtpUser" name="user" value="@Model.Smtp?.User" autocomplete="off"></div>
        <div class="field"><label for="smtpPassword">Password</label><input id="smtpPassword" name="password" type="password" autocomplete="new-password" placeholder="@(string.IsNullOrEmpty(Model.Smtp?.Password) ? "" : Masking.Placeholder(Model.Smtp?.Password))"></div>
        <div class="field"><label for="testTo">Send a test to</label><input id="testTo" name="testTo" type="email"></div>
    </div>
    <label class="check"><input type="checkbox" name="ssl" value="true" checked="@(Model.Smtp?.Ssl ?? true)"><span>Use TLS</span></label>
    @if (Model.CanChange) { <div class="actions"><button class="btn" type="submit">Save</button></div> }
</form>

<form method="post" asp-page-handler="Badge" class="card">
    <h3>Payer pages</h3>
    <p class="hint">Checkout and payment links show only the merchant and the payment. A small "Secured by PayLink" line sits under them; turn it off to offer PayLink under your own brand.</p>
    <label class="check"><input type="checkbox" name="show" value="true" checked="@Model.CheckoutBadge"><span>Show "Secured by PayLink" on payer pages</span></label>
    <input type="hidden" name="show" value="false">
    @if (Model.CanChange) { <div class="actions"><button class="btn" type="submit">Save</button></div> }
</form>

<form method="post" asp-page-handler="Files" class="card">
    <h3>File storage</h3>
    <p class="hint">Where payers' UPI screenshots are kept. Each stored file remembers where it is, so changing this never strands old ones.</p>
    <div class="opts">
        <label class="opt"><input type="radio" name="kind" value="local" checked="@(Model.Files.Kind != "filelink")"><div><b>The data folder</b><span><code>files/</code>, included in backups.</span></div></label>
        <label class="opt"><input type="radio" name="kind" value="filelink" checked="@(Model.Files.Kind == "filelink")"><div><b>FileLink</b><span>A FileLink server (see docs/filelink-contract.md). Checked before it's saved.</span></div></label>
        <div class="reveal card"><div class="grid2">
            <div class="field"><label for="flServer">FileLink address</label><input id="flServer" name="server" class="mono" value="@Model.Files.Server" placeholder="https://files.example.in"></div>
            <div class="field"><label for="flKey">Key</label><input id="flKey" name="key" type="password" autocomplete="new-password" placeholder="@(string.IsNullOrEmpty(Model.Files.Key) ? "" : Masking.Placeholder(Model.Files.Key))"></div>
        </div></div>
    </div>
    @if (Model.CanChange) { <div class="actions"><button class="btn" type="submit">Save</button></div> }
</form>

<form method="post" asp-page-handler="Domain" class="card">
    <h3>Tenant subdomains</h3>
    <p class="hint">Give tenants their own console address, <code>acme.@(Model.TenantDomain.Length == 0 ? "paylink.example.com" : Model.TenantDomain)</code>. Point wildcard DNS (<code>*.your-domain</code>) at PayLink and serve a wildcard TLS certificate, then switch each tenant on its page. Leave blank to keep everyone on <code>/{slug}/console</code>.</p>
    <div class="field"><label for="tenantDomain">Tenant domain</label><input id="tenantDomain" name="tenantDomain" class="mono" value="@Model.TenantDomain" placeholder="paylink.websvc.in"></div>
    @if (Model.CanChange) { <div class="actions"><button class="btn" type="submit">Save</button></div> }
</form>

<form method="post" asp-page-handler="MovePlatform" class="card">
    <h3>Move the platform database</h3>
    <p class="hint">Now: @Model.PlatformDescription. PayLink creates the new database, copies and counts every row, then switches; the current one is kept untouched. Tenants' own databases don't move.</p>
    <div class="opts">
        <label class="opt"><input type="radio" name="to" value="sqlite"><div><b>SQLite</b><span>A new file in the data folder.</span></div></label>
        <label class="opt"><input type="radio" name="to" value="auto"><div><b>MySQL, auto-provisioned</b><span>On the platform's database hosting.</span></div></label>
        <label class="opt"><input type="radio" name="to" value="byo"><div><b>A MySQL or PostgreSQL database you give</b><span>It must be empty.</span></div></label>
        <div class="reveal card"><partial name="_ServerDbFields" model='("Platform", new PayLink.Pages.ServerDbInput())' /></div>
    </div>
    @if (Model.CanChange) { <div class="actions"><button class="btn" type="submit">Move the platform database</button></div> }
</form>

<form method="post" asp-page-handler="Limits" class="card">
    <h3>Platform limits</h3>
    <p class="hint">Floors every tenant works within: they can tighten them with their own risk rules, never loosen them. Per-connector limits are in the <a href="/admin/connectors">connector catalog</a>.</p>
    <div class="grid2">
        <div class="field"><label for="maxAmount">Largest payment (₹)</label><input id="maxAmount" name="maxAmount" inputmode="decimal" value="@Model.LimitMax" placeholder="No limit"></div>
        <div class="field"><label for="currencies">Currencies allowed</label><input id="currencies" name="currencies" class="mono" value="@Model.LimitCurrencies" placeholder="Any, e.g. INR, USD"></div>
    </div>
    @if (Model.CanChange) { <div class="actions"><button class="btn pri" type="submit">Save limits</button></div> }
</form>

<div class="card">
    <h3>Payment connectors in this version</h3>
    <p class="hint">Each is its own NuGet package and depends only on WebSvc.PayLink.Abstractions, so updating one can't break another. Tenants turn them on in their console. Installing, allowing and draining connectors from here arrives with the connector catalog (Phase 3).</p>
    <div class="tbl">
        <table>
            <thead><tr><th>Connector</th><th>Package</th><th>Methods</th><th>Currencies</th><th></th></tr></thead>
            <tbody>
            @foreach (var c in Model.Connectors)
            {
                <tr>
                    <td><b>@c.Manifest.Name</b> <span class="hint mono">@c.Manifest.Id</span></td>
                    <td class="mono">@c.GetType().Assembly.GetName().Name @c.Manifest.Version</td>
                    <td>@string.Join(", ", c.Manifest.Methods)</td>
                    <td>@(c.Manifest.Currencies.Contains("*") ? "any" : string.Join(", ", c.Manifest.Currencies))</td>
                    <td>@if (c.Manifest.TestOnly) { <span class="chip warn">Test only</span> }</td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>

<div class="card">
    <div class="actions" style="justify-content:space-between"><h3>Data folder and backups</h3>
        @if (Model.CanChange) { <a class="btn pri" href="?handler=Backup">Download backup</a> }</div>
    <p class="hint">Everything PayLink writes to disk is in <code>@Model.DataRoot</code> (set with <code>PayLink__DataRoot</code>). A backup is a .zip with consistent copies of its databases and files; restore it on a fresh install at setup step 2. Databases on MySQL aren't inside it: back them up with your MySQL tools.</p>
    <p class="hint">Encryption key: @(Model.KeySource == "environment" ? "from PayLink__MasterKey (not in backups: keep it with them)" : "inside bootstrap.db (included in backups: keep them private)") · fingerprint <code>@Model.KeyFingerprint</code></p>
    <div class="tbl"><partial name="_DataFolderContents" model="Model.DataFolderItems" /></div>
</div>
