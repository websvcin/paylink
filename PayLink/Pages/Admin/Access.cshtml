@page "/admin/access"
@model PayLink.Pages.Admin.AccessModel
@{
    ViewData["Title"] = "Sign-in access";
    ViewData["Where"] = "Platform console";
    var org = string.IsNullOrEmpty(Model.PlatformOrg) ? "the platform root organization" : Model.PlatformOrg;
}
@section Nav { <partial name="_AdminNav" /> }
@section Who { <partial name="_AdminWho" /> }

<div class="head"><div><h1>Sign-in access</h1><p>Who can open this platform console. Everyone signs in through LoginLink (@org) first; this decides who gets in.</p></div></div>

<form method="post" asp-page-handler="Mode" class="card">
    <h3>Who may sign in</h3>
    <div class="opts">
        <label class="opt"><input type="radio" name="mode" value="approve_only" checked="@(Model.Mode == AdmissionModes.ApproveOnly)"><div><b>Only people I approve</b><span>Recommended for the platform. New people wait in the list below.</span></div></label>
        <label class="opt"><input type="radio" name="mode" value="auto_tenant_admins" checked="@(Model.Mode == AdmissionModes.AutoTenantAdmins)"><div><b>Auto-approve @org's LoginLink admins</b><span>Anyone whose LoginLink token says <code>user_kind = tenant_admin</code> gets admin access.</span></div></label>
        <label class="opt"><input type="radio" name="mode" value="role" checked="@(Model.Mode == AdmissionModes.Role)"><div><b>Anyone with a PayLink platform role in LoginLink</b><span><code>@AdmissionModes.PlatformAdminRole</code> gives admin access, <code>@AdmissionModes.PlatformSupportRole</code> gives read-only access. Removing the role in LoginLink removes access at the next sign-in.</span></div></label>
    </div>
    @if (Model.CanChange) { <div class="actions"><button class="btn pri" type="submit">Save</button></div> }
</form>

<div class="card flush">
    <div class="tbl">
        <table>
            <thead><tr><th>Person</th><th>Access</th><th>How</th><th>Last sign-in</th><th></th></tr></thead>
            <tbody>
            @foreach (var p in Model.People)
            {
                <tr>
                    <td><b>@(p.Email ?? p.Subject)</b><div class="hint">@p.Name</div></td>
                    <td>@if (p.Status == "pending") { <span class="chip warn">Waiting</span> } else if (p.Access == "admin") { <span class="chip acc">Admin</span> } else { <span class="chip">Support (read-only)</span> }</td>
                    <td class="hint">@(p.Status == "pending" ? "asked for access" : p.Source == "setup" ? "first admin (setup)" : p.Source == "auto" ? "let in automatically" : "approved by " + p.DecidedBy)</td>
                    <td class="hint">@Clock.Display(p.LastSignInAt)</td>
                    <td>
                        @if (Model.CanChange)
                        {
                            <div class="actions">
                                @if (p.Status == "pending" || p.Access == "support")
                                {
                                    <form method="post" asp-page-handler="Decide" class="inline"><input type="hidden" name="subject" value="@p.Subject"><input type="hidden" name="decision" value="approve"><input type="hidden" name="access" value="admin"><button class="btn sm pri" type="submit">Approve as admin</button></form>
                                }
                                @if (p.Status == "pending" || p.Access == "admin")
                                {
                                    <form method="post" asp-page-handler="Decide" class="inline"><input type="hidden" name="subject" value="@p.Subject"><input type="hidden" name="decision" value="approve"><input type="hidden" name="access" value="support"><button class="btn sm" type="submit">@(p.Status == "pending" ? "Approve as support" : "Make read-only")</button></form>
                                }
                                <form method="post" asp-page-handler="Decide" class="inline"><input type="hidden" name="subject" value="@p.Subject"><input type="hidden" name="decision" value="remove"><button class="btn sm danger" type="submit">@(p.Status == "pending" ? "Decline" : "Remove")</button></form>
                            </div>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
