@page "/{slug}/console/developers"
@model PayLink.Pages.Console.DevelopersModel
@{
    ViewData["Title"] = "Developers";
    ViewData["Where"] = Model.Tenant.Name;
    var mode = Model.ModeName;
}
@section Nav { <partial name="_ConsoleNav" /> }
@section Who { <partial name="_ConsoleWho" /> }

<div class="head"><div><h1>Developers</h1><p>Two kinds of keys, for two jobs: <a href="#integration">integration keys</a> for taking payments from your website or app, and <a href="#automation">automation keys</a> for scripts that run this console. Adding payment methods later needs no code change. See <a href="/docs">the developer docs</a> and the <a href="/docs/api">API reference</a>.</p></div></div>

@if (TempData["Secret"] is string secret)
{
    <div class="notice good">
        <p><b>Copy this now: it's shown only once.</b> (@TempData["SecretFor"])</p>
        <p class="secret" style="margin-top:8px">@secret</p>
    </div>
}

<h2 id="integration">1. Integration keys <span class="hint">· take payments from your website or app</span></h2>
<div class="grid2">
    <div class="card">
        <p class="muted">A <b>secret key</b> (<code>sk_@(mode)_@(Model.Tenant.Slug)_…</code>) lets <b>your server</b> create payments, read their status and refund through the <b>Payments API</b> (<code>/api/v1</code>), the way you'd integrate PhonePe or PayU, once for every method. Keep it on the server, never in a browser or app. @(Model.Livemode ? "Live keys take real money." : "Test keys only ever create test payments; switch to Live in the menu for live keys.")</p>
        <pre class="secret" style="white-space:pre-wrap;user-select:text">curl @Model.BaseUrl/api/v1/payments \
  -H "Authorization: Bearer sk_@(mode)_@(Model.Tenant.Slug)_…" \
  -H "Idempotency-Key: order-1042" -H "Content-Type: application/json" \
  -d '{ "amount": 149900, "currency": "INR", "reference": "order-1042",
        "return_url": "https://example.com/orders/1042" }'</pre>
        <p class="hint"><a href="/docs/payments-api">Payments API guide</a> · <a href="/docs/api/index.html?urls.primaryName=Payments%20API">reference</a></p>
    </div>
    <div class="card">
        @if (Model.CanDevelop)
        {
            <form method="post" asp-page-handler="Key" class="stack">
                <h3>New @(Model.Livemode ? "live" : "test") secret key</h3>
                <input type="hidden" name="kind" value="secret">
                <div class="field"><label for="skname">Where it's used</label><input id="skname" name="name" placeholder="Shop server" required></div>
                <div class="actions"><button class="btn pri" type="submit">Create secret key</button></div>
            </form>
        }
        <div class="tbl">
            <table>
                <thead><tr><th>Secret key</th><th>Mode</th><th>Last used</th><th></th></tr></thead>
                <tbody>
                @foreach (var k in Model.Keys.Where(k => k.Kind == TenantKeyKinds.Secret))
                {
                    <tr>
                        <td><b>@k.Name</b><br><span class="mono hint">@k.KeyPrefix</span></td>
                        <td><span class="chip @(k.Livemode ? "good" : "warn")">@(k.Livemode ? "Live" : "Test")</span></td>
                        <td class="hint">@Clock.Short(k.LastUsedAt)</td>
                        <td>@if (k.RevokedAt is not null) { <span class="chip bad">Revoked</span> }
                            else if (Model.CanDevelop) { <form method="post" asp-page-handler="Revoke" class="inline"><input type="hidden" name="id" value="@k.Id"><button class="btn sm danger" type="submit">Revoke</button></form> }</td>
                    </tr>
                }
                @if (!Model.Keys.Any(k => k.Kind == TenantKeyKinds.Secret)) { <tr><td colspan="4" class="empty">No secret keys yet</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

<h2 id="automation">2. Automation keys <span class="hint">· scripts that run this console</span></h2>
<div class="grid2">
    <div class="card">
        <p class="muted">A <b>developer key</b> (<code>tdk_@(Model.Tenant.Slug)_…</code>) lets <b>your scripts and back-office tools</b> do what your team does here, through the <b>tenant API</b> (<code>/api/tenant</code>): approve UPI payments and upload bank statements, create links and payments, refund, set up methods and routing, webhooks, risk rules, alerts, team, domain, reports, reconciliation and more. It can do only what you tick. Choose test or live data with <code>?livemode=true</code>.</p>
        <pre class="secret" style="white-space:pre-wrap;user-select:text">curl "@Model.BaseUrl/api/tenant/upi/statements?livemode=true" \
  -H "Authorization: Bearer tdk_@(Model.Tenant.Slug)_…" -F statement=@@today.csv</pre>
        <p class="hint"><a href="/docs/automation">Automation guide</a> · <a href="/docs/api/index.html?urls.primaryName=Tenant%20automation%20API">reference</a></p>
    </div>
    <div class="card">
        @if (Model.CanDevelop)
        {
            <form method="post" asp-page-handler="Key" class="stack">
                <h3>New developer key</h3>
                <input type="hidden" name="kind" value="developer">
                <div class="field"><label for="dkname">What it's for</label><input id="dkname" name="name" placeholder="Nightly UPI matching" required></div>
                <label class="check"><input type="checkbox" id="capall"><span><b>Everything</b> (full automation of this console)</span></label>
                <div class="caps" id="caps">
                    @foreach (var (key, label) in TenantCapabilities.All) { <label><input type="checkbox" name="capabilities" value="@key"><div>@key<span>@label</span></div></label> }
                </div>
                <div class="actions"><button class="btn pri" type="submit">Create developer key</button></div>
            </form>
            <script>
                document.getElementById('capall').addEventListener('change', e => document.querySelectorAll('#caps input').forEach(c => c.checked = e.target.checked));
            </script>
        }
        <div class="tbl">
            <table>
                <thead><tr><th>Developer key</th><th>Can</th><th>Last used</th><th></th></tr></thead>
                <tbody>
                @foreach (var k in Model.Keys.Where(k => k.Kind == TenantKeyKinds.Developer))
                {
                    <tr>
                        <td><b>@k.Name</b><br><span class="mono hint">@k.KeyPrefix</span></td>
                        <td class="hint">@(k.CapabilityList.Count == TenantCapabilities.All.Length ? "everything" : string.Join(", ", k.CapabilityList))</td>
                        <td class="hint">@Clock.Short(k.LastUsedAt)</td>
                        <td>@if (k.RevokedAt is not null) { <span class="chip bad">Revoked</span> }
                            else if (Model.CanDevelop) { <form method="post" asp-page-handler="Revoke" class="inline"><input type="hidden" name="id" value="@k.Id"><button class="btn sm danger" type="submit">Revoke</button></form> }</td>
                    </tr>
                }
                @if (!Model.Keys.Any(k => k.Kind == TenantKeyKinds.Developer)) { <tr><td colspan="4" class="empty">No developer keys yet</td></tr> }
                </tbody>
            </table>
        </div>
    </div>
</div>

<h2 id="webhooks">3. Webhooks <span class="hint">· PayLink tells your server what happened</span></h2>
<div class="card flush">
    <div class="tbl">
        <table>
            <thead><tr><th>@(Model.Livemode ? "Live" : "Test") webhook endpoint</th><th>Events</th><th>Added</th><th></th></tr></thead>
            <tbody>
            @foreach (var e in Model.Endpoints.Where(e => e.Livemode == Model.Livemode))
            {
                <tr>
                    <td class="mono">@e.Url@if (e.Description is not null) { <br><span class="hint">@e.Description</span> }</td>
                    <td class="hint">@(e.Events == "*" ? "All payment events" : e.Events.Replace(",", ", "))</td>
                    <td class="hint">@Clock.Short(e.CreatedAt)</td>
                    <td>@if (Model.CanDevelop)
                        {
                            <div class="actions">
                                <form method="post" asp-page-handler="TestEndpoint" class="inline"><input type="hidden" name="id" value="@e.Id"><button class="btn sm" type="submit">Send test</button></form>
                                <form method="post" asp-page-handler="RemoveEndpoint" class="inline"><input type="hidden" name="id" value="@e.Id"><button class="btn sm danger" type="submit">Remove</button></form>
                            </div>
                        }</td>
                </tr>
            }
            @if (!Model.Endpoints.Any(e => e.Livemode == Model.Livemode)) { <tr><td colspan="4" class="empty">No @mode endpoints. PayLink signs every delivery with <code>PayLink-Signature</code> and retries for a day.</td></tr> }
            </tbody>
        </table>
    </div>
</div>

@if (Model.CanDevelop)
{
    <form method="post" asp-page-handler="Endpoint" class="card">
        <h3>Add a @mode webhook endpoint</h3>
        <div class="grid2">
            <div class="field"><label for="url">URL</label><input id="url" name="url" type="url" class="mono" placeholder="https://example.com/hooks/paylink" required>@if (Model.Livemode) { <span class="hint">Live endpoints must use https.</span> }</div>
            <div class="field"><label for="desc">Description</label><input id="desc" name="description" placeholder="Order service"></div>
        </div>
        <details>
            <summary>Only some events (default: all)</summary>
            <div class="caps" style="margin-top:8px">
                @foreach (var ev in WebhookEvents.All) { <label><input type="checkbox" name="events" value="@ev"><div>@ev</div></label> }
            </div>
        </details>
        <div class="actions"><button class="btn pri" type="submit">Add endpoint</button></div>
    </form>
}

<div class="card flush">
    <div class="tbl">
        <table>
            <thead><tr><th>Recent webhook</th><th>Status</th><th>Tries</th><th>Last answer</th><th></th></tr></thead>
            <tbody>
            @foreach (var d in Model.Deliveries)
            {
                <tr>
                    <td>@d.EventType<br><span class="hint mono">@(d.PaymentId ?? d.EventId)</span></td>
                    <td><span class="chip @(d.Status == "delivered" ? "good" : d.Status == "failed" ? "bad" : "warn")">@d.Status</span>@if (d.Status == "pending" && d.NextAttemptAt is not null) { <br><span class="hint">next @Clock.Short(d.NextAttemptAt)</span> }</td>
                    <td class="num">@d.AttemptCount</td>
                    <td class="hint">@string.Join(" · ", new[] { d.LastStatusCode?.ToString(), d.LastResponse }.Where(x => !string.IsNullOrEmpty(x)))@(d.LastDurationMs is null ? "" : $" · {d.LastDurationMs} ms")</td>
                    <td>@if (Model.CanDevelop) { <form method="post" asp-page-handler="Redeliver" class="inline"><input type="hidden" name="deliveryId" value="@d.Id"><button class="btn sm" type="submit">Send again</button></form> }</td>
                </tr>
            }
            @if (Model.Deliveries.Count == 0) { <tr><td colspan="5" class="empty">No @mode webhooks sent yet</td></tr> }
            </tbody>
        </table>
    </div>
</div>

<h2 id="log">4. API request log <span class="hint">· every call made with this account's keys</span></h2>
<div class="card flush">
    <div class="tbl">
        <table>
            <thead><tr><th>Recent API call</th><th>Key</th><th>Status</th><th>Time</th><th>When</th></tr></thead>
            <tbody>
            @foreach (var r in Model.Requests)
            {
                <tr>
                    <td class="mono">@r.Method @r.Path@if (r.IdempotencyKey is not null) { <br><span class="hint">Idempotency-Key @r.IdempotencyKey</span> }</td>
                    <td>@(r.KeyName ?? "—")</td>
                    <td><span class="chip @(r.Status < 300 ? "good" : r.Status < 500 ? "warn" : "bad")">@r.Status</span>@if (r.Error is not null) { <br><span class="hint">@r.Error</span> }</td>
                    <td class="num">@r.DurationMs ms</td>
                    <td class="hint">@Clock.Short(r.At)</td>
                </tr>
            }
            @if (Model.Requests.Count == 0) { <tr><td colspan="5" class="empty">No API calls yet</td></tr> }
            </tbody>
        </table>
    </div>
</div>
