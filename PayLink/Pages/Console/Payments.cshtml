@page "/{slug}/console/payments"
@model PayLink.Pages.Console.PaymentsModel
@{
    ViewData["Title"] = "Payments";
    ViewData["Where"] = Model.Tenant.Name;
    var root = $"/{Model.Tenant.Slug}/console";
}
@section Nav { <partial name="_ConsoleNav" /> }
@section Who { <partial name="_ConsoleWho" /> }

<div class="head"><div><h1>Payments</h1><p>Every @Model.ModeName payment, whichever method was used. Open one to see its full journey.</p></div></div>

<form method="get" class="card filters" role="search">
    <div class="searchbar">
        <input name="q" value="@Model.Q" placeholder="Payment ID, your reference, UTR, email, phone, name…" aria-label="Search payments">
        <select name="status" aria-label="Status">
            <option value="">Any status</option>
            @foreach (var s in PaymentStatuses.All) { <option value="@s" selected="@(Model.Status == s)">@PaymentStatuses.Label(s)</option> }
        </select>
        <select name="method" aria-label="Method">
            <option value="">Any method</option>
            @foreach (var (id, name) in Model.Methods) { <option value="@id" selected="@(Model.Method == id)">@name</option> }
        </select>
    </div>
    <div class="rangebar">
        <span class="label">Created</span>
        <a class="btn sm @(Model.Dates is null ? "pri" : "")" href="?@(Model.Dates is null ? Model.Query() : Model.Query().Replace(Model.Dates.Query, "range=all"))">All time</a>
        @foreach (var (key, label) in DateRange.Presets)
        {
            <button class="btn sm @(Model.Dates?.Preset == key ? "pri" : "")" type="submit" name="range" value="@key">@label</button>
        }
        <span class="custom"><label class="sr" for="from">From</label><input id="from" name="from" type="date" value="@(Model.Dates?.Preset == "custom" ? Model.Dates.From.ToString("yyyy-MM-dd") : "")">
        <span class="hint">to</span><label class="sr" for="to">To</label><input id="to" name="to" type="date" value="@(Model.Dates?.Preset == "custom" ? Model.Dates.To.ToString("yyyy-MM-dd") : "")"></span>
        <span class="custom"><input name="min" value="@Model.Min" inputmode="decimal" placeholder="Min ₹" aria-label="Lowest amount" style="width:7em"><input name="max" value="@Model.Max" inputmode="decimal" placeholder="Max ₹" aria-label="Highest amount" style="width:7em"></span>
        <button class="btn pri" type="submit">Apply</button>
        <a class="btn sm" href="?">Clear</a>
    </div>
    <p class="hint">Dates are in UTC. For a custom range, fill in From (and To) and press Apply.</p>
</form>

<div class="stats">
    <div class="stat"><span>Payments</span><b class="num">@Model.Totals.Count.ToString("N0")</b></div>
    <div class="stat"><span>Amount</span><b class="num">@Money.Format(Model.Totals.Amount, "INR")</b></div>
    <div class="stat"><span>Paid</span><b class="num">@Money.Format(Model.Totals.Paid, "INR")</b></div>
    <div class="stat"><span>Range</span><b>@(Model.Dates?.Label ?? "all time")</b></div>
</div>

<div class="card flush">
    <div class="tbl">
        <table>
            <thead><tr><th>Payment</th><th>Amount</th><th>Status</th><th>Customer</th><th>Method</th><th>Created</th></tr></thead>
            <tbody>
            @foreach (var p in Model.List)
            {
                <tr>
                    <td><a href="@root/payments/@p.Id" class="mono">@p.Id</a>@if (p.Reference is not null) { <br><span class="hint">@p.Reference</span> }</td>
                    <td class="num">@Money.Format(p.Amount, p.Currency)</td>
                    <td><span class="chip @PaymentStatuses.Tone(p.Status)">@PaymentStatuses.Label(p.Status)</span>@if (p.RefundLabel is { } rl) { <br><span class="hint">@rl</span> }</td>
                    <td>@(p.CustomerName ?? p.CustomerEmail ?? p.CustomerPhone ?? "—")</td>
                    <td>@(p.Connector ?? "—")@if (p.Utr is not null) { <br><span class="hint mono">UTR @p.Utr</span> }</td>
                    <td><time>@Clock.Short(p.CreatedAt)</time></td>
                </tr>
            }
            @if (Model.List.Count == 0)
            {
                <tr><td colspan="6" class="empty">No @Model.ModeName payments match</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="actions pager">
    @if (Model.PageNo > 1) { <a class="btn sm" href="?@Model.Query(1)">« Newest</a><a class="btn sm" href="?@Model.Query(Model.PageNo - 1)">← Newer</a> }
    <span class="hint">Page @Model.PageNo of @Model.Pages</span>
    @if (Model.PageNo < Model.Pages) { <a class="btn sm" href="?@Model.Query(Model.PageNo + 1)">Older →</a><a class="btn sm" href="?@Model.Query(Model.Pages)">Oldest »</a> }
    <span class="spacer"></span>
    <a class="btn sm" href="?handler=Csv&@Model.Query()">Download these as CSV</a>
</div>

@if (Model.CanOperate)
{
    <form method="post" asp-page-handler="Create" class="card">
        <h3>Create a payment</h3>
        <p class="hint">No code needed: PayLink gives you a checkout link to send to your customer. It's a @Model.ModeName payment and expires in 30 minutes.</p>
        <div class="grid3">
            <div class="field"><label for="amount">Amount (₹)</label><input id="amount" name="amount" inputmode="decimal" placeholder="1,499.00" required></div>
            <div class="field"><label for="description">What it's for</label><input id="description" name="description" placeholder="Course fee, October"></div>
            <div class="field"><label for="reference">Your reference</label><input id="reference" name="reference" class="mono" placeholder="INV-1042"></div>
            <div class="field"><label for="email">Customer email</label><input id="email" name="email" type="email"></div>
            <div class="field"><label for="phone">Customer phone</label><input id="phone" name="phone" inputmode="tel"></div>
        </div>
        <div class="actions"><button class="btn pri" type="submit">Create and get link</button></div>
    </form>
}
