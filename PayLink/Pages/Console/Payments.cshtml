@page "/{slug}/console/payments"
@model PayLink.Pages.Console.PaymentsModel
@{
    ViewData["Title"] = "Payments";
    ViewData["Where"] = Model.Tenant.Name;
    var root = $"/{Model.Tenant.Slug}/console";
}
@section Nav { <partial name="_ConsoleNav" /> }
@section Who { <partial name="_ConsoleWho" /> }

<div class="head"><div><h1>Payments</h1><p>Every @Model.ModeName payment, whichever method was used. Open one to see its full journey.</p></div></div>

<form method="get" class="searchbar" role="search">
    <input name="q" value="@Model.Q" placeholder="Payment ID, your reference, UTR, email, phone…" aria-label="Search payments">
    <select name="status" aria-label="Status">
        <option value="">Any status</option>
        @foreach (var s in PaymentStatuses.All) { <option value="@s" selected="@(Model.Status == s)">@PaymentStatuses.Label(s)</option> }
    </select>
    <button class="btn" type="submit">Search</button>
</form>

<div class="card flush">
    <div class="tbl">
        <table>
            <thead><tr><th>Payment</th><th>Amount</th><th>Status</th><th>Customer</th><th>Method</th><th>Created</th></tr></thead>
            <tbody>
            @foreach (var p in Model.List.Take(PayLink.Pages.Console.PaymentsModel.PageSize))
            {
                <tr>
                    <td><a href="@root/payments/@p.Id" class="mono">@p.Id</a>@if (p.Reference is not null) { <br><span class="hint">@p.Reference</span> }</td>
                    <td class="num">@Money.Format(p.Amount, p.Currency)</td>
                    <td><span class="chip @PaymentStatuses.Tone(p.Status)">@PaymentStatuses.Label(p.Status)</span>@if (p.RefundLabel is { } rl) { <br><span class="hint">@rl</span> }</td>
                    <td>@(p.CustomerName ?? p.CustomerEmail ?? p.CustomerPhone ?? "—")</td>
                    <td>@(p.Connector ?? "—")@if (p.Utr is not null) { <br><span class="hint mono">UTR @p.Utr</span> }</td>
                    <td><time>@Clock.Short(p.CreatedAt)</time></td>
                </tr>
            }
            @if (Model.List.Count == 0)
            {
                <tr><td colspan="6" class="empty">No @Model.ModeName payments@(string.IsNullOrEmpty(Model.Q) && string.IsNullOrEmpty(Model.Status) ? " yet" : " match")</td></tr>
            }
            </tbody>
        </table>
    </div>
</div>
<div class="actions">
    @if (Model.PageNo > 1) { <a class="btn sm" href="?q=@Model.Q&status=@Model.Status&p=@(Model.PageNo - 1)">← Newer</a> }
    @if (Model.List.Count > PayLink.Pages.Console.PaymentsModel.PageSize) { <a class="btn sm" href="?q=@Model.Q&status=@Model.Status&p=@(Model.PageNo + 1)">Older →</a> }
</div>

@if (Model.CanOperate)
{
    <form method="post" asp-page-handler="Create" class="card">
        <h3>Create a payment</h3>
        <p class="hint">No code needed: PayLink gives you a checkout link to send to your customer. It's a @Model.ModeName payment and expires in 30 minutes.</p>
        <div class="grid3">
            <div class="field"><label for="amount">Amount (₹)</label><input id="amount" name="amount" inputmode="decimal" placeholder="1,499.00" required></div>
            <div class="field"><label for="description">What it's for</label><input id="description" name="description" placeholder="Course fee, October"></div>
            <div class="field"><label for="reference">Your reference</label><input id="reference" name="reference" class="mono" placeholder="INV-1042"></div>
            <div class="field"><label for="email">Customer email</label><input id="email" name="email" type="email"></div>
            <div class="field"><label for="phone">Customer phone</label><input id="phone" name="phone" inputmode="tel"></div>
        </div>
        <div class="actions"><button class="btn pri" type="submit">Create and get link</button></div>
    </form>
}
