@page "/{slug}/console/risk"
@model PayLink.Pages.Console.RiskModel
@{
    ViewData["Title"] = "Risk rules";
    ViewData["Where"] = Model.Tenant.Name;
}
@section Nav { <partial name="_ConsoleNav" /> }
@section Who { <partial name="_ConsoleWho" /> }

<div class="head"><div><h1>Risk rules</h1><p>Rules run when a payment is created and when the payer starts paying. <b>Block</b> stops the payment; <b>Review</b> holds it until someone releases it. Each decision is recorded on the payment; the payer only sees a plain message. Rules apply to test and live payments.</p></div></div>

<div class="card flush">
    <div class="tbl">
        <table>
            <thead><tr><th>Checks</th><th>Value</th><th>Then</th><th>Note</th><th>Added</th><th></th></tr></thead>
            <tbody>
            @foreach (var r in Model.Rules)
            {
                <tr>
                    <td>@(RiskEngine.Kinds.FirstOrDefault(k => k.Kind == r.Kind).Label ?? r.Kind)</td>
                    <td class="mono">@r.Value</td>
                    <td><span class="chip @(r.Action == "block" ? "bad" : "warn")">@r.Action</span></td>
                    <td>@r.Note</td>
                    <td class="hint">@Clock.Short(r.CreatedAt) · @r.CreatedBy</td>
                    <td>@if (Model.CanConfigure) { <form method="post" asp-page-handler="Remove" class="inline"><input type="hidden" name="id" value="@r.Id"><button class="btn sm danger" type="submit">Remove</button></form> }</td>
                </tr>
            }
            @if (Model.Rules.Count == 0) { <tr><td colspan="6" class="empty">No rules yet. Every payment is allowed.</td></tr> }
            </tbody>
        </table>
    </div>
</div>

@if (Model.CanConfigure)
{
    <div class="card">
        <h3>Start from a common rule</h3>
        <p class="hint">One click adds the rule; remove it any time. Amounts are in rupees.</p>
        <div class="presets">
            @foreach (var t in RiskModel.Templates)
            {
                <form method="post" asp-page-handler="Add" class="preset">
                    <input type="hidden" name="kind" value="@t.Kind"><input type="hidden" name="action" value="@t.Action"><input type="hidden" name="note" value="@t.Title">
                    <b>@t.Title</b>
                    <span class="hint">@t.Why</span>
                    <div class="row">
                        @if (t.Editable) { <input name="value" value="@t.Value" class="mono sm" aria-label="Value for @t.Title" required> }
                        else { <input type="hidden" name="value" value="@t.Value"> }
                        <span class="chip @(t.Action == "block" ? "bad" : "warn")">@(t.Action == "block" ? "Block" : "Hold for review")</span>
                        <button class="btn sm" type="submit">Add</button>
                    </div>
                </form>
            }
        </div>
    </div>

    <form method="post" asp-page-handler="Add" class="card" id="builder">
        <h3>Build your own</h3>
        <p class="sentence">
            When <select id="kind" name="kind" aria-label="Check">
                <optgroup label="When the payment is created">
                    @foreach (var k in RiskEngine.Kinds.Where(k => k.Stage == "create")) { <option value="@k.Kind" data-hint="@k.Hint" data-yesno="false">@k.Label.ToLowerInvariant()</option> }
                </optgroup>
                <optgroup label="When the payer starts paying">
                    @foreach (var k in RiskEngine.Kinds.Where(k => k.Stage == "checkout")) { <option value="@k.Kind" data-hint="@k.Hint" data-yesno="@(k.Hint == "yes" ? "true" : "false")">@k.Label.ToLowerInvariant()</option> }
                </optgroup>
            </select>
            <span id="valuewrap">is <input id="value" name="value" class="mono" required placeholder="@RiskEngine.Kinds[0].Hint"></span>,
            then <select id="action" name="action" aria-label="Then"><option value="review">hold it for review</option><option value="block">block it</option></select>.
        </p>
        <p class="hint" id="kindhelp">Example: @RiskEngine.Kinds[0].Hint</p>
        <div class="field"><label for="note">Note for your team (optional)</label><input id="note" name="note" placeholder="Why this rule exists"></div>
        <div class="actions"><button class="btn pri" type="submit">Add rule</button></div>
        <details class="hint"><summary>How the risk score works</summary>
            <p>“Risk score above” adds up these signals at checkout (0–100):</p>
            <ul>@foreach (var s in RiskEngine.ScoreSignals) { <li><b>+@s.Weight</b> @s.Meaning</li> }</ul>
            <p>Start with <b>Hold for review above 60</b>, watch what it catches for a week, then tighten.</p>
        </details>
    </form>
    <script>
    (() => {
        const kind = document.getElementById('kind'), value = document.getElementById('value'), wrap = document.getElementById('valuewrap'), help = document.getElementById('kindhelp');
        const sync = () => {
            const o = kind.selectedOptions[0], yesno = o.dataset.yesno === 'true';
            wrap.hidden = yesno; value.required = !yesno; if (yesno) value.value = 'yes'; else if (value.value === 'yes') value.value = '';
            value.placeholder = o.dataset.hint; help.textContent = yesno ? 'No value needed.' : 'Example: ' + o.dataset.hint;
        };
        kind.addEventListener('change', sync); sync();
    })();
    </script>
}
