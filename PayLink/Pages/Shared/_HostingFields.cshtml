@using WebSvc.PayLink.Storage.Provisioning
@model (PayLink.Pages.HostingInput Input, bool AllowNone, HostingSettings Saved)
@{
    var i = Model.Input;
    // Each secret says whether one is saved, so a blank field is never mistaken for a kept password.
    string Keep(string? saved) => PayLink.Infrastructure.Masking.Placeholder(saved);
}
<div class="opts">
    @if (Model.AllowNone)
    {
        <label class="opt"><input type="radio" name="Hosting.Kind" value="None" data-no-test checked="@(i.Kind == HostingKind.None)"><div><b>Off</b><span>No databases are created on demand. Tenants choose SQLite or bring their own MySQL or PostgreSQL. You can turn this on later in Admin → Database hosting.</span></div></label>
    }
    <label class="opt"><input type="radio" name="Hosting.Kind" value="MySqlServer" checked="@(i.Kind == HostingKind.MySqlServer)"><div><b>A MySQL server</b><span>Any MySQL 8 server and an admin account that can create databases and users. Tested end to end.</span></div></label>
    <div class="reveal card">
        <div class="grid2">
            <div class="field"><label for="h_MySqlHost">Host</label><input id="h_MySqlHost" name="Hosting.MySqlHost" class="mono" value="@i.MySqlHost" placeholder="db.example.com"><partial name="_HostHint" model="@("h_MySqlHost")" /></div>
            <div class="field"><label for="h_MySqlPort">Port</label><input id="h_MySqlPort" name="Hosting.MySqlPort" type="number" class="mono" value="@i.MySqlPort"></div>
            <div class="field"><label for="h_MySqlAdminUser">Admin user</label><input id="h_MySqlAdminUser" name="Hosting.MySqlAdminUser" class="mono" value="@i.MySqlAdminUser" placeholder="root" autocomplete="off"></div>
            <div class="field"><label for="h_MySqlAdminPassword">Admin password</label><input id="h_MySqlAdminPassword" name="Hosting.MySqlAdminPassword" type="password" class="mono" placeholder="@Keep(Model.Saved.MySqlServer?.AdminPassword)" autocomplete="new-password"></div>
            <div class="field"><label for="h_MySqlSslMode">SSL mode</label>
                <select id="h_MySqlSslMode" name="Hosting.MySqlSslMode">
                    @foreach (var mode in new[] { MySqlConnector.MySqlSslMode.Required, MySqlConnector.MySqlSslMode.Preferred, MySqlConnector.MySqlSslMode.VerifyFull, MySqlConnector.MySqlSslMode.None })
                    {
                        <option value="@mode" selected="@(i.MySqlSslMode == mode)">@mode</option>
                    }
                </select>
            </div>
            <div class="field"><label for="h_MySqlUserHost">New users may connect from</label><input id="h_MySqlUserHost" name="Hosting.MySqlUserHost" class="mono" value="@i.MySqlUserHost"><span class="hint"><code>%</code> means any address. Use PayLink's address to be stricter.</span></div>
        </div>
    </div>

    <label class="opt"><input type="radio" name="Hosting.Kind" value="Plesk" checked="@(i.Kind == HostingKind.Plesk)"><div><b>Plesk</b><span>Creates databases in a Plesk subscription through Plesk's REST API.</span></div></label>
    <div class="reveal card">
        <div class="grid3">
            <div class="field"><label for="h_PleskHost">Plesk panel host or IP</label><input id="h_PleskHost" name="Hosting.PleskHost" class="mono" value="@i.PleskHost" placeholder="plesk.example.com"><span class="hint">No https:// or port.</span></div>
            <div class="field"><label for="h_PleskPort">Port</label><input id="h_PleskPort" name="Hosting.PleskPort" type="number" class="mono" value="@i.PleskPort"></div>
            <div class="field"><label for="h_PleskSubscriptionId">Subscription ID</label><input id="h_PleskSubscriptionId" name="Hosting.PleskSubscriptionId" type="number" class="mono" value="@(i.PleskSubscriptionId == 0 ? "" : i.PleskSubscriptionId)"><span class="hint">In the address bar when you open the subscription in Plesk.</span></div>
        </div>
        <span class="label">How PayLink signs in to Plesk</span>
        <div class="opts">
            <label class="opt"><input type="radio" name="Hosting.PleskAuth" value="login" checked="@(i.PleskAuth != "key")"><div><b>Admin login and password</b><span>The same login you use for the Plesk panel.</span></div></label>
            <div class="reveal card grid2">
                <div class="field"><label for="h_PleskLogin">Login</label><input id="h_PleskLogin" name="Hosting.PleskLogin" class="mono" value="@i.PleskLogin" placeholder="admin" autocomplete="off"></div>
                <div class="field"><label for="h_PleskPassword">Password</label><input id="h_PleskPassword" name="Hosting.PleskPassword" type="password" class="mono" placeholder="@Keep(Model.Saved.Plesk?.Password)" autocomplete="new-password"></div>
            </div>
            <label class="opt"><input type="radio" name="Hosting.PleskAuth" value="key" checked="@(i.PleskAuth == "key")"><div><b>Secret key</b><span>A narrower, revocable key. Generate it on the server with <code>plesk bin secret_key --create</code>.</span></div></label>
            <div class="reveal card">
                <div class="field"><label for="h_PleskSecretKey">Secret key</label><input id="h_PleskSecretKey" name="Hosting.PleskSecretKey" type="password" class="mono" placeholder="@Keep(Model.Saved.Plesk?.SecretKey)" autocomplete="new-password"></div>
            </div>
        </div>
    </div>

    <label class="opt"><input type="radio" name="Hosting.Kind" value="CPanel" checked="@(i.Kind == HostingKind.CPanel)"><div><b>cPanel</b><span>Creates databases in a cPanel account through cPanel's API.</span></div></label>
    <div class="reveal card">
        <div class="grid3">
            <div class="field"><label for="h_CPanelHost">cPanel host</label><input id="h_CPanelHost" name="Hosting.CPanelHost" class="mono" value="@i.CPanelHost" placeholder="cpanel.example.com"></div>
            <div class="field"><label for="h_CPanelPort">Port</label><input id="h_CPanelPort" name="Hosting.CPanelPort" type="number" class="mono" value="@i.CPanelPort"></div>
            <div class="field"><label for="h_CPanelUsername">Account user name</label><input id="h_CPanelUsername" name="Hosting.CPanelUsername" class="mono" value="@i.CPanelUsername" autocomplete="off"></div>
        </div>
        <div class="field"><label for="h_CPanelApiToken">API token</label><input id="h_CPanelApiToken" name="Hosting.CPanelApiToken" type="password" class="mono" placeholder="@Keep(Model.Saved.CPanel?.ApiToken)" autocomplete="new-password"><span class="hint">cPanel → Security → Manage API Tokens.</span></div>
    </div>
</div>
<div class="field" id="h_override">
    <label for="h_ConnectionHostOverride">Host PayLink connects to (optional)</label>
    <input id="h_ConnectionHostOverride" name="Hosting.ConnectionHostOverride" class="mono" value="@i.ConnectionHostOverride" placeholder="Same as the host above">
    @{
        var docker = ViewData["DockerHost"] as string;
        var suggestions = new List<(string Value, string Why)>();
        if (docker is not null) suggestions.Add((docker, "this container's gateway, detected"));
        if (docker != "172.17.0.1") suggestions.Add(("172.17.0.1", "Docker's usual bridge gateway (Linux)"));
        suggestions.Add(("host.docker.internal", "Docker Desktop"));
        suggestions.Add(("localhost", "PayLink and MySQL on the same machine, no Docker"));
    }
    <div class="suggest" role="group" aria-label="Suggested hosts">
        <span class="hint">Suggestions:</span>
        @foreach (var (value, why) in suggestions)
        {
            <button type="button" class="btn sm" title="@why" onclick="document.getElementById('h_ConnectionHostOverride').value='@value';document.getElementById('h_ConnectionHostOverride').dispatchEvent(new Event('input',{bubbles:true}))">@value</button>
        }
    </div>
    <span class="hint">Leave it blank and PayLink uses the host above (Plesk: the address its MySQL reports). Fill it in when PayLink must reach the databases another way.
        In Docker, <code>localhost</code> is the container itself: use the Docker host, usually <code>@(docker ?? "172.17.0.1")</code> on Linux or <code>host.docker.internal</code> on Docker Desktop.</span>
</div>
<script>
    // Show, as the placeholder, the host PayLink will connect to when this is left blank, as you type.
    (function () {
        var o = document.getElementById('h_ConnectionHostOverride');
        var hosts = { MySqlServer: 'h_MySqlHost', Plesk: 'h_PleskHost', CPanel: 'h_CPanelHost' };
        function update() {
            var kind = document.querySelector('input[name="Hosting.Kind"]:checked');
            var box = document.getElementById('h_override');
            box.hidden = !kind || kind.value === 'None';
            var host = kind && hosts[kind.value] ? document.getElementById(hosts[kind.value]).value.trim() : '';
            o.placeholder = (host ? 'Blank: PayLink connects to ' + host : 'Blank: same as the host above') + ' · in Docker usually @(ViewData["DockerHost"] as string ?? "172.17.0.1")';
        }
        document.querySelectorAll('input[name="Hosting.Kind"], #h_MySqlHost, #h_PleskHost, #h_CPanelHost').forEach(function (e) { e.addEventListener('input', update); e.addEventListener('change', update); });
        update();
    })();
</script>
