@using WebSvc.PayLink.Storage.Provisioning
@model (PayLink.Pages.HostingInput Input, bool AllowNone, bool HasSaved)
@{
    var i = Model.Input;
    var keep = Model.HasSaved ? "Kept. Leave blank to keep it." : "";
}
<div class="opts">
    @if (Model.AllowNone)
    {
        <label class="opt"><input type="radio" name="Hosting.Kind" value="None" checked="@(i.Kind == HostingKind.None)"><div><b>Off</b><span>No databases are created on demand. Tenants choose SQLite or bring their own MySQL. You can turn this on later in Admin → Database hosting.</span></div></label>
    }
    <label class="opt"><input type="radio" name="Hosting.Kind" value="MySqlServer" checked="@(i.Kind == HostingKind.MySqlServer)"><div><b>A MySQL server</b><span>Any MySQL 8 server and an admin account that can create databases and users. Tested end to end.</span></div></label>
    <div class="reveal card">
        <div class="grid2">
            <div class="field"><label for="h_MySqlHost">Host</label><input id="h_MySqlHost" name="Hosting.MySqlHost" class="mono" value="@i.MySqlHost" placeholder="db.example.com"><partial name="_HostHint" model="@("h_MySqlHost")" /></div>
            <div class="field"><label for="h_MySqlPort">Port</label><input id="h_MySqlPort" name="Hosting.MySqlPort" type="number" class="mono" value="@i.MySqlPort"></div>
            <div class="field"><label for="h_MySqlAdminUser">Admin user</label><input id="h_MySqlAdminUser" name="Hosting.MySqlAdminUser" class="mono" value="@i.MySqlAdminUser" placeholder="root" autocomplete="off"></div>
            <div class="field"><label for="h_MySqlAdminPassword">Admin password</label><input id="h_MySqlAdminPassword" name="Hosting.MySqlAdminPassword" type="password" class="mono" placeholder="@keep" autocomplete="new-password"></div>
            <div class="field"><label for="h_MySqlSslMode">SSL mode</label>
                <select id="h_MySqlSslMode" name="Hosting.MySqlSslMode">
                    @foreach (var mode in new[] { MySqlConnector.MySqlSslMode.Required, MySqlConnector.MySqlSslMode.Preferred, MySqlConnector.MySqlSslMode.VerifyFull, MySqlConnector.MySqlSslMode.None })
                    {
                        <option value="@mode" selected="@(i.MySqlSslMode == mode)">@mode</option>
                    }
                </select>
            </div>
            <div class="field"><label for="h_MySqlUserHost">New users may connect from</label><input id="h_MySqlUserHost" name="Hosting.MySqlUserHost" class="mono" value="@i.MySqlUserHost"><span class="hint"><code>%</code> means any address. Use PayLink's address to be stricter.</span></div>
        </div>
    </div>

    <label class="opt"><input type="radio" name="Hosting.Kind" value="Plesk" checked="@(i.Kind == HostingKind.Plesk)"><div><b>Plesk</b><span>Creates databases in a Plesk subscription through Plesk's REST API.</span></div></label>
    <div class="reveal card">
        <div class="grid3">
            <div class="field"><label for="h_PleskHost">Plesk panel host or IP</label><input id="h_PleskHost" name="Hosting.PleskHost" class="mono" value="@i.PleskHost" placeholder="plesk.example.com"><span class="hint">No https:// or port.</span></div>
            <div class="field"><label for="h_PleskPort">Port</label><input id="h_PleskPort" name="Hosting.PleskPort" type="number" class="mono" value="@i.PleskPort"></div>
            <div class="field"><label for="h_PleskSubscriptionId">Subscription ID</label><input id="h_PleskSubscriptionId" name="Hosting.PleskSubscriptionId" type="number" class="mono" value="@(i.PleskSubscriptionId == 0 ? "" : i.PleskSubscriptionId)"><span class="hint">In the address bar when you open the subscription in Plesk.</span></div>
        </div>
        <span class="label">How PayLink signs in to Plesk</span>
        <div class="opts">
            <label class="opt"><input type="radio" name="Hosting.PleskAuth" value="login" checked="@(i.PleskAuth != "key")"><div><b>Admin login and password</b><span>The same login you use for the Plesk panel.</span></div></label>
            <div class="reveal card grid2">
                <div class="field"><label for="h_PleskLogin">Login</label><input id="h_PleskLogin" name="Hosting.PleskLogin" class="mono" value="@i.PleskLogin" placeholder="admin" autocomplete="off"></div>
                <div class="field"><label for="h_PleskPassword">Password</label><input id="h_PleskPassword" name="Hosting.PleskPassword" type="password" class="mono" placeholder="@keep" autocomplete="new-password"></div>
            </div>
            <label class="opt"><input type="radio" name="Hosting.PleskAuth" value="key" checked="@(i.PleskAuth == "key")"><div><b>Secret key</b><span>A narrower, revocable key. Generate it on the server with <code>plesk bin secret_key --create</code>.</span></div></label>
            <div class="reveal card">
                <div class="field"><label for="h_PleskSecretKey">Secret key</label><input id="h_PleskSecretKey" name="Hosting.PleskSecretKey" type="password" class="mono" placeholder="@keep" autocomplete="new-password"></div>
            </div>
        </div>
    </div>

    <label class="opt"><input type="radio" name="Hosting.Kind" value="CPanel" checked="@(i.Kind == HostingKind.CPanel)"><div><b>cPanel</b><span>Creates databases in a cPanel account through cPanel's API.</span></div></label>
    <div class="reveal card">
        <div class="grid3">
            <div class="field"><label for="h_CPanelHost">cPanel host</label><input id="h_CPanelHost" name="Hosting.CPanelHost" class="mono" value="@i.CPanelHost" placeholder="cpanel.example.com"></div>
            <div class="field"><label for="h_CPanelPort">Port</label><input id="h_CPanelPort" name="Hosting.CPanelPort" type="number" class="mono" value="@i.CPanelPort"></div>
            <div class="field"><label for="h_CPanelUsername">Account user name</label><input id="h_CPanelUsername" name="Hosting.CPanelUsername" class="mono" value="@i.CPanelUsername" autocomplete="off"></div>
        </div>
        <div class="field"><label for="h_CPanelApiToken">API token</label><input id="h_CPanelApiToken" name="Hosting.CPanelApiToken" type="password" class="mono" placeholder="@keep" autocomplete="new-password"><span class="hint">cPanel → Security → Manage API Tokens.</span></div>
    </div>
</div>
<details>
    <summary>Advanced: how PayLink reaches the databases it creates</summary>
    <div class="field" style="margin-top:8px"><label for="h_ConnectionHostOverride">Connection host override</label><input id="h_ConnectionHostOverride" name="Hosting.ConnectionHostOverride" class="mono" value="@i.ConnectionHostOverride"><span class="hint">Leave blank to use the panel's host. Set it when PayLink must reach the databases at another address, for example from a container on the same server.</span><partial name="_HostHint" model="@("h_ConnectionHostOverride")" /></div>
</details>
