@model (string Prefix, PayLink.Pages.ServerDbInput Input)
@{
    var p = Model.Prefix;
    var i = Model.Input;
}
<div class="actions" role="group" aria-label="Database engine">
    <label><input type="radio" name="@(p).Engine" value="mysql" checked="@(!i.IsPostgreSql)" data-engine-for="@p"> MySQL</label>
    <label><input type="radio" name="@(p).Engine" value="postgresql" checked="@i.IsPostgreSql" data-engine-for="@p"> PostgreSQL</label>
</div>
<div class="opts">
    <label class="opt"><input type="radio" name="@(p).UseConnectionString" value="false" checked="@(!i.UseConnectionString)"><div><b>Enter details</b><span>Host, port, database, user, password and SSL mode</span></div></label>
    <div class="reveal card">
        <div class="grid2">
            <div class="field"><label for="@(p)_Host">Host</label><input id="@(p)_Host" name="@(p).Host" class="mono" value="@i.Host" placeholder="db.example.com"><partial name="_HostHint" model="@(p + "_Host")" /></div>
            <div class="field"><label for="@(p)_Port">Port</label><input id="@(p)_Port" name="@(p).Port" class="mono" type="number" value="@i.Port"></div>
            <div class="field"><label for="@(p)_Database">Database name</label><input id="@(p)_Database" name="@(p).Database" class="mono" value="@i.Database"></div>
            <div class="field"><label for="@(p)_User">User</label><input id="@(p)_User" name="@(p).User" class="mono" value="@i.User" autocomplete="off"></div>
            <div class="field"><label for="@(p)_Password">Password</label><input id="@(p)_Password" name="@(p).Password" class="mono" type="password" autocomplete="new-password"></div>
            <div class="field"><label for="@(p)_SslMode">SSL mode</label>
                <select id="@(p)_SslMode" name="@(p).SslMode">
                    @foreach (var mode in new[] { MySqlConnector.MySqlSslMode.Required, MySqlConnector.MySqlSslMode.Preferred, MySqlConnector.MySqlSslMode.VerifyFull, MySqlConnector.MySqlSslMode.None })
                    {
                        <option value="@mode" selected="@(i.SslMode == mode)">@mode</option>
                    }
                </select>
            </div>
        </div>
    </div>
    <label class="opt"><input type="radio" name="@(p).UseConnectionString" value="true" checked="@i.UseConnectionString"><div><b>Paste a connection string</b><span id="@(p)_CsExample">@(i.IsPostgreSql ? "For example Host=db.example.com;Port=5432;Database=paylink;Username=paylink;Password=…;SSL Mode=Require" : "For example Server=db.example.com;Port=3306;Database=paylink;Uid=paylink;Pwd=…;SslMode=Required")</span></div></label>
    <div class="reveal card">
        <div class="field"><label for="@(p)_ConnectionString">Connection string</label><input id="@(p)_ConnectionString" name="@(p).ConnectionString" class="mono" autocomplete="off"></div>
    </div>
</div>
<script>
    // The usual port and connection string example follow the engine.
    document.querySelectorAll('input[data-engine-for="@p"]').forEach(r => r.addEventListener('change', () => {
        const pg = r.value === 'postgresql', port = document.getElementById('@(p)_Port');
        if (port && (port.value === '3306' || port.value === '5432' || port.value === '')) port.value = pg ? '5432' : '3306';
        document.getElementById('@(p)_CsExample').textContent = pg
            ? 'For example Host=db.example.com;Port=5432;Database=paylink;Username=paylink;Password=…;SSL Mode=Require'
            : 'For example Server=db.example.com;Port=3306;Database=paylink;Uid=paylink;Pwd=…;SslMode=Required';
    }));
</script>
