@page "/setup"
@model PayLink.Pages.Setup.IndexModel
@using WebSvc.PayLink.Storage.Provisioning
@{
    ViewData["Title"] = "Set up PayLink";
    ViewData["Where"] = "First-run setup";
}
<div class="narrow main">
    <div class="head"><div><h1>Set up PayLink</h1><p>A few steps, once. There's no default account: the first platform admin signs in through LoginLink.</p></div></div>

    <nav class="steps" aria-label="Setup steps">
        @foreach (var (key, title) in PayLink.Pages.Setup.IndexModel.Steps)
        {
            var cls = key == Model.Step ? "step now" : Model.IsDone(key) ? "step done" : "step";
            if (Model.Unlocked && (Model.IsDone(key) || key == Model.Step))
            {
                <a class="@cls" href="/setup?step=@key">@title</a>
            }
            else
            {
                <span class="@cls">@title</span>
            }
        }
    </nav>

    @if (Model.Message is not null) { <div class="notice good" role="status">@Model.Message</div> }
    @if (Model.Warning is not null) { <div class="notice warn" role="status">@Model.Warning</div> }
    @if (Model.Error is not null) { <div class="notice bad" role="alert">@Model.Error</div> }

    @switch (Model.Step)
    {
        case "unlock":
            <div class="card">
                <h2>Where PayLink keeps its data</h2>
                <dl class="kv">
                    <dt>Data folder</dt><dd><code>@Model.DataRoot</code></dd>
                    <dt>Set by</dt><dd>@(Model.DataRootConfigured ? "the PayLink__DataRoot setting" : "default: App_Data next to PayLink (PayLink__DataRoot isn't set)")</dd>
                </dl>
                <p class="muted">PayLink has already created the first files here; nothing else is written without a setup step or a tenant asking for it:</p>
                <div class="tbl"><partial name="_DataFolderContents" model="Model.DataFolderItems" /></div>
                @if (Model.InContainer && Model.OnMountedVolume == false)
                {
                    <div class="notice bad">
                        <p><b>This folder is inside the container.</b> Removing or upgrading the container deletes it, including the encryption keys. Stop here and re-create the container with a volume:</p>
                        <pre class="secret" style="margin-top:8px;white-space:pre-wrap">docker run -d --name paylink -p 8080:8080 -v /srv/paylink/App_Data:/app/App_Data websvcin/paylink:latest</pre>
                        <p class="hint">With docker compose, keep <code>volumes: - ./App_Data:/app/App_Data</code> under the paylink service.</p>
                    </div>
                }
                else if (Model.InContainer && Model.OnMountedVolume == true)
                {
                    <div class="notice good">Stored on a mounted volume, so it survives container restarts and image upgrades.</div>
                }
                else if (Model.InsideAppFolder)
                {
                    <div class="notice warn">This folder is inside PayLink's own folder. Publishing a new version over it (Plesk, IIS, a copy) can overwrite it. Set <code>PayLink__DataRoot</code> to a folder outside it and restart PayLink. Fine for trying PayLink out.</div>
                }
                <details>
                    <summary>How to put the data folder somewhere else</summary>
                    <p class="hint" style="margin:8px 0">Set <code>PayLink__DataRoot</code> to an absolute path and restart PayLink. It can't be changed from this page, because PayLink needs it before it can read anything.</p>
                    <div class="tbl">
                        <table>
                            <tbody>
                                <tr><td>Docker</td><td><code>-v /srv/paylink/App_Data:/app/App_Data</code> (the image already uses /app/App_Data)</td></tr>
                                <tr><td>docker compose</td><td><code>volumes: - ./App_Data:/app/App_Data</code></td></tr>
                                <tr><td>Windows (PowerShell)</td><td><code>$env:PayLink__DataRoot = "D:\PayLinkData"; dotnet PayLink.dll</code></td></tr>
                                <tr><td>IIS / Plesk on Windows</td><td>web.config: <code>&lt;environmentVariable name="PayLink__DataRoot" value="D:\PayLinkData" /&gt;</code></td></tr>
                                <tr><td>Linux (systemd)</td><td><code>Environment=PayLink__DataRoot=/var/lib/paylink</code></td></tr>
                                <tr><td>appsettings.json</td><td><code>"PayLink": { "DataRoot": "D:\\PayLinkData" }</code></td></tr>
                            </tbody>
                        </table>
                    </div>
                </details>
            </div>
            <form method="post" asp-page-handler="Unlock" class="card">
                <h2>Setup code</h2>
                @if (Model.SetupCodeConfigured)
                {
                    <p class="muted">Enter the code you set in <code>PayLink__SetupCode</code>.</p>
                }
                else if (Model.IsLocalRequest)
                {
                    <p class="muted">You're on the PayLink server itself, so the code is filled in for you. It proves that whoever finishes setup also runs the server.</p>
                }
                else
                {
                    <p class="muted">A one-time code that proves whoever finishes setup also runs the server, so a fresh install on the internet can't be claimed by a stranger. Find it in any of these:</p>
                    <ul class="hint" style="margin:0;padding-left:1.2em">
                        <li>the startup log: <code>docker logs paylink</code>, <code>docker compose logs paylink</code>, or the console window</li>
                        <li>the file <code>@Model.SetupCodeFile</code> (deleted when setup finishes)</li>
                        <li>or choose your own: set <code>PayLink__SetupCode</code> and restart</li>
                    </ul>
                }
                <div class="field"><label for="Code">Setup code</label><input id="Code" name="Code" class="mono" value="@Model.Code" autocomplete="off" autofocus></div>
                <div class="actions"><button class="btn pri" type="submit">Continue</button></div>
            </form>
            break;

        case "start":
            <div class="card">
                <h2>New installation, or restore a backup?</h2>
                <p class="muted">Start fresh, or bring back a PayLink you backed up: a <code>.zip</code> from <b>Admin → Settings → Download backup</b>, or a <code>bootstrap.db</code> on its own.</p>
            </div>
            <form method="post" asp-page-handler="StartNew" class="card">
                <h3>New installation</h3>
                <p class="muted">PayLink encrypts every password, key and connection string it stores (AES-256-GCM). The encryption key lives in the data folder, inside <code>bootstrap.db</code>, the same way LoginLink keeps its own. So the data folder is all you need to keep:</p>
                <ul class="hint" style="margin:0 0 10px;padding-left:1.2em">
                    <li><b>In Docker</b>, mount the data folder as a volume (<code>-v /srv/paylink/App_Data:/app/App_Data</code>). Nothing else to set: no key to copy into the container's settings.</li>
                    <li><b>Back it up</b> (or download a backup from Admin → Settings), and a new server picks up exactly where this one left off.</li>
                    <li><b>Keep backups private</b>: a copy of the folder can read the stored secrets.</li>
                </ul>
                <dl class="kv">
                    <dt>Key</dt><dd>@(Model.KeySource == "environment" ? "from PayLink__MasterKey (set on this server)" : "generated by PayLink, inside bootstrap.db") · fingerprint <code>@Model.KeyFingerprint</code></dd>
                </dl>
                <details>
                    <summary>Advanced: keep the key outside the data folder</summary>
                    <p class="hint" style="margin:8px 0">Only if your security policy wants the key apart from the data. Set <code>PayLink__MasterKey</code> to a random 32-byte value (for example the output of <code>openssl rand -base64 32</code>) before PayLink first starts, and keep it as safely as the data: without it, stored secrets can't be read. PayLink uses it automatically when it's set; you don't need to do anything on this page.</p>
                </details>
                <label class="check"><input type="checkbox" name="understood" value="true"><span>I'll back up the data folder @(Model.KeySource == "environment" ? "and PayLink__MasterKey " : "")and keep the backups private.</span></label>
                <div class="actions"><button class="btn pri" type="submit">Continue with a new installation</button></div>
            </form>
            <form method="post" asp-page-handler="Restore" enctype="multipart/form-data" class="card">
                <h3>Restore a backup</h3>
                <p class="muted">PayLink checks the file first (that it's a real PayLink backup, and that its key can read its secrets), then replaces this data folder's files. The current files are kept in a <code>before-restore-…</code> folder. A backup that had finished setup goes straight to sign-in.</p>
                <div class="field"><label for="backup">Backup file (.zip or bootstrap.db)</label><input id="backup" name="backup" type="file" accept=".zip,.db"></div>
                <p class="hint">Databases on MySQL or PostgreSQL aren't inside a backup file; PayLink reconnects to them using the details stored in bootstrap.db.</p>
                <div class="actions"><button class="btn" type="submit">Upload and restore</button></div>
            </form>
            break;

        case "hosting":
            <form method="post" asp-page-handler="Hosting" class="card" data-gate="@(Model.Tested ? "tested" : "untested")">
                <h2>Auto-provisioning <span class="chip">Optional</span></h2>
                <p class="muted">Lets PayLink create MySQL databases on demand, each with its own user and password. Use it for the platform database (next step) and, if you allow it, for tenants' databases. You can turn it on or change it later in Admin → Database hosting.</p>
                <partial name="_HostingFields" model="(Model.Hosting, true, Model.HostingDraftOrSaved)" />
                <h3>Tenant databases</h3>
                <p class="hint">Who may have a MySQL database created for them when they sign up. Admins can change this in Admin → Auto-provisioning.</p>
                <div class="opts">
                    <label class="opt"><input type="radio" name="TenantAutoProvision" value="approved" checked="@(Model.TenantAutoProvision == AutoProvisionModes.Approved)"><div><b>Approved LoginLink organizations only</b><span>You add organizations to an approval list first. Recommended.</span></div></label>
                    <label class="opt"><input type="radio" name="TenantAutoProvision" value="everyone" checked="@(Model.TenantAutoProvision == AutoProvisionModes.Everyone)"><div><b>Every new tenant</b><span>Each one creates a database on your hosting, with its limits and costs.</span></div></label>
                    <label class="opt"><input type="radio" name="TenantAutoProvision" value="off" checked="@(Model.TenantAutoProvision == AutoProvisionModes.Off)"><div><b>Platform database only</b><span>Tenants use SQLite or their own MySQL or PostgreSQL.</span></div></label>
                </div>
                <div class="actions">
                    <button class="btn pri" type="submit" name="action" value="test">1. Test &amp; verify</button>
                    <button class="btn" type="submit" name="action" value="save" data-needs-test>2. Save and continue</button>
                    <button class="btn" type="submit" name="action" value="skip">Skip for now</button>
                    <span class="hint" data-gate-hint hidden></span>
                </div>
            </form>
            break;

        case "database":
            var hostingHost = Model.SavedHosting.ConnectionHostOverride ?? Model.SavedHosting.Kind switch
            {
                HostingKind.MySqlServer => Model.SavedHosting.MySqlServer?.Host,
                HostingKind.Plesk => "the MySQL server Plesk uses for the subscription",
                HostingKind.CPanel => Model.SavedHosting.CPanel?.Host,
                _ => null,
            };
            <form method="post" asp-page-handler="Database" class="card" data-gate="@(Model.Tested ? "tested" : "untested")">
                <h2>Platform database</h2>
                <p class="muted">Holds the tenant registry, platform admins, developer keys and the platform audit log. Each tenant gets its own separate database later.</p>
                <div class="opts">
                    <label class="opt"><input type="radio" name="DbChoice" value="sqlite" data-no-test checked="@(Model.DbChoice == "sqlite")"><div><b>SQLite</b><span>Nothing to set up or test. Creates <code>platform.db</code> in the data folder.</span></div></label>
                    <label class="opt"><input type="radio" name="DbChoice" value="mysql" checked="@(Model.DbChoice == "mysql")"><div><b>MySQL or PostgreSQL: a server I run</b><span>An empty database, or an existing PayLink platform database to reattach.</span></div></label>
                    <div class="reveal card">
                        <partial name="_ServerDbFields" model='("Mysql", Model.Mysql)' />
                        @if (Model.DbDraft is { } tested && tested.Engine != WebSvc.PayLink.Storage.DbEngine.Sqlite)
                        {
                            <p class="hint">Tested: @tested.Describe(). Its password (<span class="mono">••••••••••</span>) is kept, so you don't need to type it again.</p>
                        }
                    </div>
                    @if (Model.SavedHosting.Kind != HostingKind.None)
                    {
                        <label class="opt"><input type="radio" name="DbChoice" value="mysql-create" checked="@(Model.DbChoice == "mysql-create")"><div><b>MySQL: create it for me (auto-provision)</b><span>On @Model.SavedHosting.Describe(), with its own user and a generated password.</span></div></label>
                        <div class="reveal card">
                            <div class="field"><label for="PlatformDbName">Database name</label><input id="PlatformDbName" name="PlatformDbName" class="mono" value="@Model.PlatformDbName"><span class="hint">Proposed for you; change it if you like. Lowercase letters, digits and underscores.</span></div>
                            <dl class="kv">
                                <dt>Created on</dt><dd>@Model.SavedHosting.Describe()</dd>
                                <dt>PayLink connects to</dt><dd class="mono">@(hostingHost ?? "the host the hosting reports")@(Model.SavedHosting.Kind == HostingKind.MySqlServer ? $":{Model.SavedHosting.MySqlServer?.Port}" : ":3306")</dd>
                                <dt>User</dt><dd><span class="mono">pl_u_••••••••</span> <span class="hint">generated when the database is created</span></dd>
                                <dt>Password</dt><dd><span class="mono">••••••••••••••••••••••••</span> <span class="hint">generated (24 characters), stored encrypted, never shown</span></dd>
                            </dl>
                        </div>
                    }
                    else
                    {
                        <div class="opt disabled"><input type="radio" disabled><div><b>MySQL: create it for me (auto-provision)</b><span>Turn on auto-provisioning in the previous step to use this.</span></div></div>
                    }
                    @foreach (var engine in EngineCatalog.All.Where(e => !e.Available))
                    {
                        <div class="opt disabled"><input type="radio" disabled><div><b>@engine.Name</b><span>@engine.Note</span></div></div>
                    }
                </div>
                <div class="actions">
                    <button class="btn pri" type="submit" name="action" value="test">1. Test connection</button>
                    <button class="btn" type="submit" name="action" value="save" data-needs-test>2. Create tables and continue</button>
                    <span class="hint" data-gate-hint hidden></span>
                </div>
            </form>
            break;

        case "loginlink":
            var draft = Model.Draft;
            <div class="card">
                <h2>Connect LoginLink</h2>
                <p class="muted">LoginLink is where everyone signs in: your platform team, each tenant's team, and API tokens. PayLink keeps no passwords. Four short steps, each tested before you continue; nothing is created in LoginLink until the last one.</p>
                <nav class="substeps" aria-label="LoginLink steps">
                    @foreach (var (key, title) in PayLink.Pages.Setup.IndexModel.LoginLinkSteps)
                    {
                        var cls = key == Model.LLStep ? "now" : Model.IsLLDone(key) ? "done" : "";
                        var reachable = Model.IsLLDone(key) || key == Model.LLStep;
                        if (reachable) { <a class="@cls" href="/setup?step=loginlink&ll=@key">@title</a> } else { <span>@title</span> }
                    }
                </nav>
            </div>
            @switch (Model.LLStep)
            {
                case "server":
                    <div class="card">
                        <h3>Before you start</h3>
                        <ul class="hint" style="margin:0;padding-left:1.2em">
                            <li>A <b>LoginLink server</b>: the public one at <code>loginlink.websvc.in</code>, or your own.</li>
                            <li><b>PayLink's public address</b>: where people reach this PayLink. LoginLink sends them back here after signing in.</li>
                            <li>Then either a <b>management credential</b> of the LoginLink organization your team uses (its Console → API Access, with <i>Register apps</i>), or a <b>platform credential</b> so PayLink can create a new organization for you (LoginLink Admin → Platform Settings → Platform API Access, with <i>CreateTenants</i>).</li>
                        </ul>
                    </div>
                    <form method="post" asp-page-handler="LLServer" class="card" data-gate="@(Model.Tested ? "tested" : "untested")">
                        <h3>5.1 The LoginLink server</h3>
                        <div class="grid2">
                            <div class="field"><label for="LL_ServerUrl">LoginLink server</label><partial name="_LockedInput" model='("LL_ServerUrl", "LL.ServerUrl", Model.LL.ServerUrl)' /><span class="hint">Filled in from <code>PayLink__LoginLink__DefaultServer</code> (or the public LoginLink). Press Edit to use your own.</span></div>
                            <div class="field"><label for="LL_PublicBaseUrl">PayLink's public address</label><partial name="_LockedInput" model='("LL_PublicBaseUrl", "LL.PublicBaseUrl", Model.LL.PublicBaseUrl)' /><span class="hint">Detected from this page. Sign-in returns to <code>@(Model.LL.PublicBaseUrl ?? Model.DetectedBaseUrl)/auth/callback</code>.</span></div>
                        </div>
                        <div class="actions">
                            <button class="btn pri" type="submit" name="action" value="test">Test connection</button>
                            <button class="btn" type="submit" name="action" value="continue" data-needs-test>Continue</button>
                            <span class="hint" data-gate-hint hidden></span>
                        </div>
                    </form>
                    break;

                case "platform":
                    <form method="post" asp-page-handler="LLPlatform" class="card" data-gate="@(Model.Tested ? "tested" : "untested")">
                        <h3>5.2 LoginLink platform credential <span class="chip">Optional, recommended</span></h3>
                        <p class="muted">A credential of the LoginLink server itself (not of one organization). With it, PayLink can create a brand-new LoginLink organization: for your own team in the next step, and for each new tenant who signs up without one. It can't register apps inside an organization that already exists; that needs the organization's own management credential (next step).</p>
                        <p class="hint">Where: LoginLink → Admin → Platform Settings → Platform API Access → create one with <b>CreateTenants</b>. Only a LoginLink platform admin can.</p>
                        <div class="grid2">
                            <div class="field"><label for="LL_PlatformApiClientId">Client ID</label><input id="LL_PlatformApiClientId" name="LL.PlatformApiClientId" class="mono" autocomplete="off" value="@Model.LL.PlatformApiClientId"></div>
                            <div class="field"><label for="LL_PlatformApiClientSecret">Client secret</label><input id="LL_PlatformApiClientSecret" name="LL.PlatformApiClientSecret" type="password" class="mono" autocomplete="new-password" placeholder="@(draft.PlatformSecret is null ? "" : Masking.Placeholder(draft.PlatformSecret))"></div>
                        </div>
                        <div class="actions">
                            <button class="btn pri" type="submit" name="action" value="test">Test credential</button>
                            <button class="btn" type="submit" name="action" value="continue" data-needs-test>Continue</button>
                            <button class="btn" type="submit" name="action" value="skip">I don't have one: skip</button>
                            <span class="hint" data-gate-hint hidden></span>
                        </div>
                    </form>
                    break;

                case "org":
                    <form method="post" asp-page-handler="LLOrg" class="card" data-gate="@(Model.Tested ? "tested" : "untested")">
                        <h3>5.3 Your organization in LoginLink</h3>
                        <p class="muted">The LoginLink organization of the people who run this PayLink platform (your company), for example <code>websvc</code>. It's not a tenant's organization: each tenant (Acme, Beta Corp…) brings or gets its own when they sign up. PayLink registers a "PayLink admin" app in your organization, and your team signs in through it.</p>
                        <div class="opts">
                            <label class="opt"><input type="radio" name="LL.AppMode" value="register" checked="@(Model.LL.AppMode is "register")"><div><b>It already exists in LoginLink</b><span>Give its slug and a management credential (its Console → API Access, with <i>Register apps</i>; <i>Manage connectors</i> too, so PayLink can switch on a sign-in method for the app).</span></div></label>
                            <div class="reveal card">
                                <div class="grid3">
                                    <div class="field"><label for="LL_PlatformOrg">Organization slug</label><input id="LL_PlatformOrg" name="LL.PlatformOrg" class="mono" value="@Model.LL.PlatformOrg" placeholder="websvc"><span class="hint">In LoginLink's address bar: …/<b>websvc</b>/console</span></div>
                                    <div class="field"><label for="LL_MgmtClientId">Client ID</label><input id="LL_MgmtClientId" name="LL.MgmtClientId" class="mono" autocomplete="off" value="@Model.LL.MgmtClientId"></div>
                                    <div class="field"><label for="LL_MgmtClientSecret">Client secret</label><input id="LL_MgmtClientSecret" name="LL.MgmtClientSecret" type="password" class="mono" autocomplete="new-password" placeholder="@(draft.MgmtSecret is null ? "" : Masking.Placeholder(draft.MgmtSecret))"></div>
                                </div>
                            </div>
                            @if (draft.PlatformOk)
                            {
                                <label class="opt"><input type="radio" name="LL.AppMode" value="create-org" checked="@(Model.LL.AppMode == "create-org")"><div><b>Create one for us <span class="chip acc">First time with LoginLink</span></b><span>Uses the platform credential from 5.2. LoginLink creates the organization with the PayLink admin app inside, and you become its first admin.</span></div></label>
                                <div class="reveal card grid2">
                                    <div class="field"><label for="LL_NewOrgName">Organization name</label><input id="LL_NewOrgName" name="LL.NewOrgName" value="@Model.LL.NewOrgName" placeholder="Your company"></div>
                                    <div class="field"><label for="LL_NewOrgAdminName">Your name</label><input id="LL_NewOrgAdminName" name="LL.NewOrgAdminName" value="@Model.LL.NewOrgAdminName"></div>
                                    <div class="field"><label for="LL_NewOrgAdminEmail">Your email</label><input id="LL_NewOrgAdminEmail" name="LL.NewOrgAdminEmail" type="email" value="@Model.LL.NewOrgAdminEmail"></div>
                                    <div class="field"><label for="LL_NewOrgAdminPassword">Password for your LoginLink account</label><input id="LL_NewOrgAdminPassword" name="LL.NewOrgAdminPassword" type="password" autocomplete="new-password" placeholder="@(draft.NewOrgAdminPassword is null ? "" : Masking.Placeholder(draft.NewOrgAdminPassword))"><span class="hint">Sent to LoginLink only; PayLink doesn't keep it after setup.</span></div>
                                </div>
                            }
                            else
                            {
                                <div class="opt disabled"><input type="radio" disabled><div><b>Create one for us</b><span>Needs the platform credential (5.2).</span></div></div>
                            }
                            <label class="opt"><input type="radio" name="LL.AppMode" value="manual" checked="@(Model.LL.AppMode == "manual")"><div><b>I registered the app myself</b><span>A confidential app in your organization with the redirect URI <code>@(draft.BaseUrl)/auth/callback</code>, "Tenant admins" ticked under "Who can sign in", and a sign-in method turned on under Connectors.</span></div></label>
                            <div class="reveal card grid3">
                                <div class="field"><label for="LL_PlatformOrg2">Organization slug</label><input id="LL_PlatformOrg2" name="LL.ManualOrg" class="mono" value="@Model.LL.PlatformOrg" placeholder="websvc"></div>
                                <div class="field"><label for="LL_ClientId">App client ID</label><input id="LL_ClientId" name="LL.ClientId" class="mono" autocomplete="off" value="@Model.LL.ClientId"></div>
                                <div class="field"><label for="LL_ClientSecret">App client secret</label><input id="LL_ClientSecret" name="LL.ClientSecret" type="password" class="mono" autocomplete="new-password" placeholder="@(draft.ClientSecret is null ? "" : Masking.Placeholder(draft.ClientSecret))"></div>
                            </div>
                            <label class="opt"><input type="radio" name="LL.AppMode" value="root" checked="@(Model.LL.AppMode == "root")"><div><b>LoginLink's platform root</b><span>Only if the LoginLink server is yours: then only LoginLink's own platform administrators can open PayLink's /admin. Needs a management credential of the root organization.</span></div></label>
                            <div class="reveal card grid2">
                                <div class="field"><label for="LL_MgmtClientIdRoot">Client ID</label><input id="LL_MgmtClientIdRoot" name="LL.RootMgmtClientId" class="mono" autocomplete="off" value="@(draft.OrgMode == "root" ? draft.MgmtId : "")"></div>
                                <div class="field"><label for="LL_MgmtClientSecretRoot">Client secret</label><input id="LL_MgmtClientSecretRoot" name="LL.RootMgmtClientSecret" type="password" class="mono" autocomplete="new-password" placeholder="@(draft.OrgMode == "root" && draft.MgmtSecret is not null ? Masking.Placeholder(draft.MgmtSecret) : "")"></div>
                            </div>
                        </div>
                        <div class="actions">
                            <button class="btn pri" type="submit" name="action" value="test">Test</button>
                            <button class="btn" type="submit" name="action" value="continue" data-needs-test>Continue</button>
                            <span class="hint" data-gate-hint hidden></span>
                        </div>
                    </form>
                    break;

                default:
                    var orgName = draft.OrgMode switch
                    {
                        "create-org" => $"your new organization \"{draft.NewOrgName}\"",
                        "root" => "LoginLink's platform root",
                        _ => $"\"{draft.Org}\"",
                    };
                    <form method="post" asp-page-handler="LLAdmins" class="card">
                        <h3>5.4 Who may open PayLink's platform console (/admin)</h3>
                        <p class="muted">Two checks, always. First LoginLink: only people of @orgName can sign in through the PayLink admin app (people of tenant organizations such as Acme can't). Then PayLink: signing in doesn't give access by itself. <b>You</b> become the first platform admin in the next step; for everyone after you, this rule decides:</p>
                        <div class="opts">
                            <label class="opt"><input type="radio" name="AdminAdmission" value="approve_only" checked="@(Model.AdminAdmission == AdmissionModes.ApproveOnly)"><div><b>Only people we approve <span class="chip acc">Recommended</span></b><span>Anyone else from @orgName who signs in waits in Admin → Sign-in access until a platform admin approves them, as admin or read-only support.</span></div></label>
                            <label class="opt"><input type="radio" name="AdminAdmission" value="auto_tenant_admins" checked="@(Model.AdminAdmission == AdmissionModes.AutoTenantAdmins)"><div><b>@orgName's LoginLink admins get in automatically</b><span>People who are admins of that organization in LoginLink become platform admins when they sign in. Other members still wait for approval.</span></div></label>
                            <label class="opt"><input type="radio" name="AdminAdmission" value="role" checked="@(Model.AdminAdmission == AdmissionModes.Role)"><div><b>Whoever holds a PayLink role in LoginLink</b><span>Give people the role <code>@AdmissionModes.PlatformAdminRole</code> (admin) or <code>@AdmissionModes.PlatformSupportRole</code> (read-only) in LoginLink. Removing the role removes access at their next sign-in.</span></div></label>
                        </div>
                        <p class="hint">You can change this any time in Admin → Sign-in access.</p>
                        <dl class="kv">
                            <dt>LoginLink</dt><dd>@draft.Server</dd>
                            <dt>Your organization</dt><dd>@orgName</dd>
                            <dt>Platform credential</dt><dd>@(draft.PlatformOk ? $"{draft.PlatformId} · {Masking.Mask(draft.PlatformSecret)}" : "none (tenants then connect organizations they already have)")</dd>
                        </dl>
                        <div class="actions"><button class="btn pri" type="submit">Finish: set it up in LoginLink</button></div>
                    </form>
                    break;
            }
            break;

        case "admin":
            <form method="post" asp-page-handler="SignIn" class="card">
                <h2>First platform administrator</h2>
                <p class="muted">Sign in with LoginLink@(string.IsNullOrEmpty(Model.SavedLoginLink?.PlatformOrg) ? "" : $" ({Model.SavedLoginLink.PlatformOrg})"). Your account becomes the first platform admin, and setup finishes.</p>
                <div class="checks">
                    <div class="check"><span class="ok">✓</span><span>Platform database: @Model.PlatformTarget?.Describe()</span></div>
                    <div class="check"><span class="ok">✓</span><span>LoginLink: @Model.SavedLoginLink?.ServerUrl@(string.IsNullOrEmpty(Model.SavedLoginLink?.PlatformOrg) ? "" : "/" + Model.SavedLoginLink.PlatformOrg)</span></div>
                    <div class="check"><span class="@(Model.SavedHosting.Kind == HostingKind.None ? "w" : "ok")">@(Model.SavedHosting.Kind == HostingKind.None ? "!" : "✓")</span><span>Database hosting: @Model.SavedHosting.Describe()</span></div>
                    <div class="check"><span class="w">!</span><span>Back up <code>@Model.DataRoot</code> (or download a backup from Admin → Settings). @(Model.KeySource == "environment" ? "Keep PayLink__MasterKey with it: " : "bootstrap.db holds the encryption key: ")without it, stored secrets can't be read.</span></div>
                </div>
                <div class="actions"><button class="btn pri" type="submit">Sign in with LoginLink</button></div>
            </form>
            break;
    }
</div>
<script src="~/js/gate.js" asp-append-version="true"></script>
